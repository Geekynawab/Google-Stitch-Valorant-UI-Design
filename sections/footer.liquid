<footer class="site-footer">
  <div class="container">
    <div class="site-footer__main">
      <div class="site-footer__brand">KNIVES FACTORY</div>
      <ul class="site-footer__links">
        {%- for link in linklists[section.settings.menu].links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
      </p>
      <div class="esrb-badge">
        <div class="esrb-badge__rating">
          <span class="esrb-badge__age">TEEN</span>
          <span class="esrb-badge__letter">T</span>
          <span class="esrb-badge__org">ESRB<sup>&reg;</sup></span>
        </div>
        <ul class="esrb-badge__descriptors">
          <li>Blood</li>
          <li>Language</li>
          <li>Violence</li>
          <li>Users Interact</li>
          <li>In-Game Purchases</li>
        </ul>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "TACTICAL PRECISION"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Not affiliated with Riot Games. All rights reserved."
    }
  ]
}
{% endschema %}
