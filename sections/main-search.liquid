<!-- Search header -->
<div class="collection-header">
  <div class="container">
    <h1>
      {%- if search.performed -%}
        Results for &ldquo;{{ search.terms | escape }}&rdquo;
      {%- else -%}
        Search
      {%- endif -%}
    </h1>

    <form action="/search" method="get" class="search-page__form">
      <input type="hidden" name="type" value="product">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search products..."
        class="search-page__input"
        autocomplete="off"
        autofocus>
      <button type="submit" class="search-page__submit">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>
    </form>
  </div>
</div>

<!-- Results -->
<section class="section collection-grid-section">
  <div class="container">

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p class="collection-empty">No results for &ldquo;{{ search.terms | escape }}&rdquo;. Try a different search.</p>
      {%- else -%}
        <p class="search-page__count">{{ search.results_count }} result{%- if search.results_count != 1 -%}s{%- endif -%}</p>
        <div class="collection-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- render 'product-card', product: item -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="collection-empty">Enter a search term above.</p>
    {%- endif -%}

  </div>
</section>

{% schema %}
{ "name": "Search Page" }
{% endschema %}
