{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="container">{% render 'breadcrumb' %}</div>
<section class="product-page">
  <div class="container">
    <div class="product-page__grid">

      <!-- Gallery -->
      <div class="product-page__gallery">
        <div class="product-gallery__main">
          {%- if product.featured_image -%}
            <img id="main-product-image"
                 src="{{ current_variant.image | default: product.featured_image | image_url: width: 1600 }}"
                 alt="{{ product.featured_image.alt | escape | default: product.title }}"
                 width="1600" height="1600">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
          {%- if product.images.size > 1 -%}
            <button class="gallery-arrow gallery-arrow--prev" aria-label="Previous image">&#8249;</button>
            <button class="gallery-arrow gallery-arrow--next" aria-label="Next image">&#8250;</button>
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="product-gallery__thumbs">
            {%- for image in product.images limit: 6 -%}
              <div class="product-gallery__thumb{%- if forloop.first %} active{%- endif -%}">
                <img src="{{ image | image_url: width: 240 }}"
                     data-full-src="{{ image | image_url: width: 1600 }}"
                     alt="{{ image.alt | escape }}"
                     width="240" height="240"
                     loading="lazy">
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Info -->
      <div class="product-info">

        <h1 class="product-info__title">{{ product.title }}</h1>

        <div class="product-info__price">
          {%- render 'price', variant: current_variant -%}
        </div>

        <!-- HUD chips -->
        {%- assign _has_length_tag = false -%}
        {%- for tag in product.tags -%}{%- if tag contains 'length:' -%}{%- assign _has_length_tag = true -%}{%- endif -%}{%- endfor -%}
        {%- if _has_length_tag -%}
        <div class="hud-chips">
          {%- for tag in product.tags -%}
            {%- if tag contains 'length:' -%}
              <div class="hud-chip">{{ tag | upcase }}</div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- endif -%}

        <form action="/cart/add" method="post">
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          <!-- Variants -->
          {%- unless product.has_only_default_variant -%}
            <div class="product-info__variants">
              {%- for option in product.options_with_values -%}
                <span class="variant-label">{{ option.name }}</span>
                <div class="variant-buttons">
                  {%- for value in option.values -%}
                    {%- assign variant_for_value = product.variants | where: 'option1', value | first -%}
                    <button type="button"
                            class="variant-btn{%- if option.selected_value == value %} active{%- endif -%}"
                            data-variant-id="{{ variant_for_value.id }}"
                            {%- unless variant_for_value.available %} disabled{%- endunless -%}>
                      {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <!-- Quantity -->
          <div class="product-info__quantity">
            <span class="variant-label">Quantity</span>
            <div class="quantity-stepper">
              <button type="button" data-qty-minus aria-label="Decrease">&minus;</button>
              <input type="number" name="quantity" value="1" min="1" aria-label="Quantity">
              <button type="button" data-qty-plus aria-label="Increase">+</button>
            </div>
          </div>

          {%- if current_variant.available -%}
            <button type="submit" class="btn-primary product-info__add-btn">
              {{ 'general.add_to_cart' | t }}
            </button>
            <button type="button" class="product-info__buy-btn">Buy Now</button>
          {%- else -%}
            <button type="button" class="btn-primary product-info__add-btn" disabled style="opacity:0.5;cursor:not-allowed;">
              {{ 'general.sold_out' | t }}
            </button>
          {%- endif -%}

        </form>

        {%- if product.description != blank -%}
          <div class="product-info__description">
            {{ product.description }}
          </div>
        {%- endif -%}

        <!-- Accordions -->
        <div class="product-accordions">

          {%- assign _lore_value = product.metafields.custom.fun_fact.value -%}
          {%- if _lore_value != blank -%}
          <div class="product-accordion product-accordion--lore">
            <button class="product-accordion__trigger" aria-expanded="false">
              <span class="product-accordion__icon">
                <span class="material-symbols-outlined">auto_stories</span>
              </span>
              <span class="product-accordion__label">Lore!</span>
              <span class="material-symbols-outlined product-accordion__chevron">expand_more</span>
            </button>
            <div class="product-accordion__body">
              <div class="product-accordion__content">{{ _lore_value | newline_to_br }}</div>
            </div>
          </div>
          {%- endif -%}

          {%- assign _ptype = product.type | downcase -%}
          {%- if _ptype contains 'knife' or _ptype contains 'karambit' or _ptype contains 'melee' -%}
            {%- assign _materials_text = product.title | prepend: 'The ' | append: ' is crafted from high-quality zinc alloy, replicating every minute detail straight from the game. Built to look and feel as close to the in-game skin as possible.' -%}
          {%- elsif _ptype contains 'weapon' or _ptype contains 'rifle' or _ptype contains 'vandal' or _ptype contains 'gun' -%}
            {%- assign _materials_text = product.title | prepend: 'The ' | append: ' is crafted from high-quality zinc alloy, replicating every minute detail straight from the game. Built to look and feel as close to the in-game skin as possible.' -%}
          {%- elsif _ptype contains 'keychain' -%}
            {%- assign _materials_text = product.title | prepend: 'The ' | append: ' is crafted from high-quality zinc alloy, replicating every minute detail straight from the game. Compact, durable, and faithful to the original in-game design.' -%}
          {%- else -%}
            {%- assign _materials_text = product.title | prepend: 'The ' | append: ' is crafted from high-quality zinc alloy, replicating every minute detail straight from the game. Built to look and feel as close to the in-game skin as possible.' -%}
          {%- endif -%}
          <div class="product-accordion">
            <button class="product-accordion__trigger" aria-expanded="false">
              <span class="product-accordion__icon">
                <span class="material-symbols-outlined">inventory_2</span>
              </span>
              <span class="product-accordion__label">Materials</span>
              <span class="material-symbols-outlined product-accordion__chevron">expand_more</span>
            </button>
            <div class="product-accordion__body">
              <div class="product-accordion__content">{{ _materials_text }}</div>
            </div>
          </div>

          {%- if product.metafields.custom.dimensions != blank -%}
          <div class="product-accordion">
            <button class="product-accordion__trigger" aria-expanded="false">
              <span class="product-accordion__icon">
                <span class="material-symbols-outlined">straighten</span>
              </span>
              <span class="product-accordion__label">Dimensions &amp; Weight</span>
              <span class="material-symbols-outlined product-accordion__chevron">expand_more</span>
            </button>
            <div class="product-accordion__body">
              <div class="product-accordion__content">{{ product.metafields.custom.dimensions.value | newline_to_br }}</div>
            </div>
          </div>
          {%- endif -%}

          <div class="product-accordion">
            <button class="product-accordion__trigger" aria-expanded="false">
              <span class="product-accordion__icon">
                <span class="material-symbols-outlined">local_shipping</span>
              </span>
              <span class="product-accordion__label">Shipping &amp; Returns</span>
              <span class="material-symbols-outlined product-accordion__chevron">expand_more</span>
            </button>
            <div class="product-accordion__body">
              <div class="product-accordion__content">Ships in 1–3 business days. Standard delivery 5–8 days ($5, free over $70). Expedited available at checkout. International orders may be subject to customs fees — these are the buyer's responsibility.<br><br>Returns accepted within 15 days of delivery. Item must be unused, with tags, and in original packaging. Contact us to start a return. Refunds processed within 10 business days of approval. No returns on sale items.</div>
            </div>
          </div>

        </div>

        <!-- Share -->
        <button class="product-share-btn" onclick="navigator.share ? navigator.share({ title: '{{ product.title | escape }}', url: window.location.href }) : navigator.clipboard.writeText(window.location.href).then(() => alert('Link copied!'))">
          <span class="material-symbols-outlined">ios_share</span>
          Share
        </button>

      </div>
    </div>

    <!-- Related products -->
    {%- if product.collections.size > 0 -%}
      {%- assign related = collections[product.collections.first.handle] -%}
      {%- if related.products.size > 1 -%}
        <div style="margin-top:var(--space-24);">
          <h2 style="margin-bottom:var(--space-8);">RELATED PRODUCTS</h2>
          <div class="products-grid">
            {%- for p in related.products limit: 5 -%}
              {%- unless p.id == product.id -%}
                {%- render 'product-card', product: p -%}
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Product Page",
  "settings": []
}
{% endschema %}
