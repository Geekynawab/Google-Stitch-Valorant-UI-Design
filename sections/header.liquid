<header class="site-header" role="banner">

  <div class="container">
    <div class="header-inner">

      <!-- Mobile only: Hamburger + MENU label -->
      <div class="header-left">
        <button class="hamburger" id="hamburger-btn" aria-label="{{ 'accessibility.open_navigation' | t }}" aria-controls="mobile-nav" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>

      <!-- Logo -->
      <a href="/" class="site-logo" aria-label="{{ shop.name }} — Home">
        {%- if settings.logo != blank -%}
          <img
            src="{{ settings.logo | image_url: width: settings.logo_width }}"
            alt="{{ shop.name }}"
            width="{{ settings.logo_width }}"
            loading="eager">
        {%- else -%}
          <span class="site-logo__text">{{ settings.logo_text | default: 'KNIVES FACTORY' }}</span>
        {%- endif -%}
      </a>

      <!-- Desktop only: Nav -->
      <nav class="desktop-nav" aria-label="Main navigation">

        <div class="desktop-nav__item" id="categories-nav-item">
          <a href="/collections/all" class="desktop-nav__link desktop-nav__btn" aria-expanded="false" aria-controls="mega-menu">
            Categories
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </a>
        </div>

        <a href="/blogs/news" class="desktop-nav__link">Blogs</a>
      </nav>

      <!-- Right: Action icons -->
      <div class="header-actions">

        <!-- Inline search — expands left of search icon -->
        <div class="header-search" id="header-search" aria-hidden="true">
          <form action="/search" method="get" class="header-search__form">
            <input type="hidden" name="type" value="product">
            <input
              type="search"
              name="q"
              id="header-search-input"
              class="header-search__input"
              placeholder="Search products..."
              autocomplete="off"
              aria-label="Search products">
          </form>
        </div>

        <button class="header-icon" id="search-toggle" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </button>
        <a href="/account" class="header-icon" aria-label="Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </a>
        <a href="/cart" class="header-icon" aria-label="{{ 'accessibility.open_cart' | t }}" style="position:relative;text-decoration:none;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span class="cart-count" aria-live="polite">{{ cart.item_count }}</span>
        </a>
      </div>

    </div>
  </div>

  <!-- Mega menu (desktop only) -->
  <div class="mega-menu" id="mega-menu" aria-hidden="true">
    <div class="container">
      <div class="mega-menu__grid">

        <!-- Shop by Collection -->
        <div class="mega-menu__col mega-menu__col--collections">
          <p class="mega-menu__heading">Shop by Collection</p>
          <div class="mega-menu__collection-grid">
            <a href="/collections/all/champions" class="mega-menu__link">Champions</a>
            <a href="/collections/all/elderflame" class="mega-menu__link">Elderflame</a>
            <a href="/collections/all/glitchpop" class="mega-menu__link">Glitchpop</a>
            <a href="/collections/all/imperium" class="mega-menu__link">Imperium</a>
            <a href="/collections/all/oni" class="mega-menu__link">Oni</a>
            <a href="/collections/all/prelude-to-chaos" class="mega-menu__link">Prelude to Chaos</a>
            <a href="/collections/all/prime" class="mega-menu__link">Prime</a>
            <a href="/collections/all/reaver" class="mega-menu__link">Reaver</a>
            <a href="/collections/all/recon" class="mega-menu__link">Recon</a>
            <a href="/collections/all/rgx" class="mega-menu__link">RGX</a>
            <a href="/collections/all/singularity" class="mega-menu__link">Singularity</a>
            <a href="/collections/all/valorant-go-vol-1" class="mega-menu__link">Valorant GO! Vol.1</a>
            <a href="/collections/all/xerohunter" class="mega-menu__link">Xerohunter</a>
          </div>
        </div>

        <!-- Divider -->
        <div class="mega-menu__divider"></div>

        <!-- Shop by Weapon -->
        <div class="mega-menu__col">
          <p class="mega-menu__heading">Shop by Weapon</p>
          <a href="/collections/all/karambit" class="mega-menu__link">Melee</a>
          <a href="/collections/all/vandal" class="mega-menu__link">Rifle</a>
        </div>

        <!-- Divider -->
        <div class="mega-menu__divider"></div>

        <!-- Keychains -->
        <div class="mega-menu__col">
          <p class="mega-menu__heading">Accessories</p>
          <a href="/collections/all/keychain" class="mega-menu__link">Shop Keychains</a>
        </div>

      </div>
    </div>
  </div>

  <!-- Nav overlay (closes mobile drawer on outside click) -->
  <div class="mobile-nav-overlay" id="mobile-nav-overlay" aria-hidden="true"></div>

  <!-- Mobile nav drawer -->
  <nav class="mobile-nav" id="mobile-nav" aria-label="Site navigation">

    <div class="mobile-nav__item">
      <a href="/collections/all" class="mobile-nav__link">All Products</a>
    </div>

    <div class="mobile-nav__item">
      <button class="mobile-nav__link mobile-nav__toggle" data-mobile-toggle="mobile-sub-types">
        Browse by Type
        <span class="toggle-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></span>
      </button>
      <div class="mobile-nav__sub" id="mobile-sub-types">
        <a href="/collections/keychains-1">Keychains</a>
        <a href="/collections/toys-1">Toys</a>
        <a href="/collections/mousepads-1">Mousepads</a>
      </div>
    </div>

    <div class="mobile-nav__item">
      <button class="mobile-nav__link mobile-nav__toggle" data-mobile-toggle="mobile-sub-collections">
        Skins
        <span class="toggle-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></span>
      </button>
      <div class="mobile-nav__sub" id="mobile-sub-collections">
        <a href="/collections/prime-1">Prime</a>
        <a href="/collections/reaver-1">Reaver</a>
        <a href="/collections/ion">Ion</a>
      </div>
    </div>

    <div class="mobile-nav__item">
      <a href="/blogs/news" class="mobile-nav__link">Blogs</a>
    </div>

  </nav>

</header>

{% schema %}
{
  "name": "Header",
  "limit": 1,
  "settings": []
}
{% endschema %}
