<section class="hero-banner" id="hero-banner-{{ section.id }}">

  <!-- Dome Gallery Background -->
  <div class="sphere-root" id="dome-bg-{{ section.id }}" aria-hidden="true">
    <main class="sphere-main">
      <div class="stage">
        <div class="sphere"></div>
      </div>
      <!-- Only directional edge fades — no radial vignette so sphere bleeds to edges -->
      <div class="edge-fade edge-fade--top"></div>
      <div class="edge-fade edge-fade--bottom"></div>
      <div class="edge-fade edge-fade--left"></div>
      <div class="edge-fade edge-fade--right"></div>
    </main>
  </div>

  <!-- Drag hint -->
  <div class="dome-drag-hint" id="dome-hint-{{ section.id }}" aria-hidden="true">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 9l-3 3 3 3M9 5l3-3 3 3M15 19l-3 3-3-3M19 9l3 3-3 3"/>
    </svg>
    <span>drag to spin</span>
  </div>

  <!-- Expand overlay (populated by JS) -->
  <div id="dome-expand-{{ section.id }}" class="dome-expand-overlay" aria-modal="true" role="dialog">
    <div class="dome-expand-card">
      <button class="dome-expand-close" aria-label="Close">&#10005;</button>
      <img class="dome-expand-img" src="" alt="">
      <div class="dome-expand-footer">
        <a class="dome-expand-btn" href="#">VIEW PRODUCT &rarr;</a>
      </div>
    </div>
  </div>

  <div class="hero-banner__overlay"></div>

  <div class="container">
    <div class="hero-banner__inner">

      <!-- Left: Text content -->
      <div class="hero-banner__content">
        {%- if section.settings.heading != blank -%}
          <h1 class="hero-banner__title glitch" data-text="{{ section.settings.heading | split: '|' | join: '' | strip_html }}">
            {%- assign title_parts = section.settings.heading | split: '|' -%}
            {%- if title_parts.size > 1 -%}
              {{ title_parts[0] }}<em>{{ title_parts[1] }}</em>{{ title_parts[2] }}
            {%- else -%}
              {{ section.settings.heading }}
            {%- endif -%}
          </h1>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="hero-banner__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        <div class="hero-banner__actions">
          {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
            <a href="{{ section.settings.cta_link }}" class="btn-primary">
              {{ section.settings.cta_label }}
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Right: Featured collection panel -->
      {%- if section.settings.featured_collection != blank -%}
        {%- assign feat = collections[section.settings.featured_collection] -%}
        {%- if feat != blank -%}
          <div class="hero-banner__panel">
            <p class="hero-panel__label">{{ feat.title | upcase }}</p>
            <div class="hero-panel__grid">
              {%- for product in feat.products limit: 4 -%}
                <a href="{{ product.url }}" class="hero-panel__item">
                  {%- if product.featured_image -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 300 }}"
                      alt="{{ product.title | escape }}"
                      loading="lazy" width="300" height="300">
                  {%- endif -%}
                  <span class="hero-panel__item-title">{{ product.title }}</span>
                </a>
              {%- endfor -%}
            </div>
            <a href="{{ feat.url }}" class="hero-panel__more">View all &rarr;</a>
          </div>
        {%- endif -%}
      {%- endif -%}

    </div>
  </div>
</section>

<style>
/* ── Sphere background ───────────────────────────────────────────── */
#dome-bg-{{ section.id }} {
  position: absolute;
  inset: 0 -12vw; /* bleed past hero edges so no gap */
  z-index: 0;
  --segments-x: 22;
  --segments-y: 22;
  --overlay-blur-color: #050f19;
  --image-filter: brightness(0.5);
  --tile-radius: 12px;
  --radius: 1500px;
  --circ: calc(var(--radius) * 3.14159);
  --rot-y: calc(360deg / var(--segments-x) / 2);
  --rot-x: calc(360deg / var(--segments-y) / 2);
  --item-width:  calc(var(--circ) / var(--segments-x));
  --item-height: calc(var(--circ) / var(--segments-y));
}

#dome-bg-{{ section.id }} * { box-sizing: border-box; }

#dome-bg-{{ section.id }} .sphere,
#dome-bg-{{ section.id }} .item,
#dome-bg-{{ section.id }} .item__image { transform-style: preserve-3d; }

#dome-bg-{{ section.id }} .sphere-main {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  overflow: hidden;
  touch-action: none;
  user-select: none;
  -webkit-user-select: none;
  background: transparent;
}

#dome-bg-{{ section.id }} .stage {
  width: 100%; height: 100%;
  display: grid;
  place-items: center;
  perspective: calc(var(--radius) * 2);
  perspective-origin: 50% 50%;
  contain: layout paint size;
}

#dome-bg-{{ section.id }} .sphere {
  transform: translateZ(calc(var(--radius) * -1));
  will-change: transform;
}

#dome-bg-{{ section.id }} .item {
  --offset-x: 0; --offset-y: 0;
  --item-size-x: 2; --item-size-y: 2;
  width:  calc(var(--item-width)  * var(--item-size-x));
  height: calc(var(--item-height) * var(--item-size-y));
  position: absolute;
  top: -999px; bottom: -999px; left: -999px; right: -999px;
  margin: auto;
  transform-origin: 50% 50%;
  backface-visibility: hidden;
  transform:
    rotateY(calc(var(--rot-y) * (var(--offset-x) + (var(--item-size-x) - 1) / 2)))
    rotateX(calc(var(--rot-x) * (var(--offset-y) - (var(--item-size-y) - 1) / 2)))
    translateZ(var(--radius));
}

#dome-bg-{{ section.id }} .item__image {
  position: absolute;
  inset: 10px;
  border-radius: var(--tile-radius, 12px);
  overflow: hidden;
  backface-visibility: hidden;
  pointer-events: auto;
  cursor: pointer;
  transition: filter 0.2s ease;
}
#dome-bg-{{ section.id }} .item__image:hover { filter: brightness(1.2); }

#dome-bg-{{ section.id }} .item__image img {
  width: 100%; height: 100%;
  object-fit: cover;
  pointer-events: none;
  backface-visibility: hidden;
  filter: var(--image-filter, none);
}

/* Directional edge fades — no radial gap */
#dome-bg-{{ section.id }} .edge-fade {
  position: absolute;
  z-index: 5;
  pointer-events: none;
}
#dome-bg-{{ section.id }} .edge-fade--top {
  top: 0; left: 0; right: 0; height: 220px;
  background: linear-gradient(to bottom, var(--overlay-blur-color), transparent);
}
#dome-bg-{{ section.id }} .edge-fade--bottom {
  bottom: 0; left: 0; right: 0; height: 220px;
  background: linear-gradient(to top, var(--overlay-blur-color), transparent);
}
#dome-bg-{{ section.id }} .edge-fade--left {
  top: 0; bottom: 0; left: 0; width: 10vw;
  background: linear-gradient(to right, var(--overlay-blur-color), transparent);
}
#dome-bg-{{ section.id }} .edge-fade--right {
  top: 0; bottom: 0; right: 0; width: 10vw;
  background: linear-gradient(to left, var(--overlay-blur-color), transparent);
}

/* ── Drag hint ───────────────────────────────────────────────────── */
.dome-drag-hint {
  position: absolute;
  bottom: 1.75rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  color: rgba(255,255,255,0.92);
  background: rgba(0,0,0,0.55);
  border: 1px solid rgba(255,255,255,0.25);
  padding: 0.55rem 1.25rem;
  border-radius: 999px;
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.82rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-family: var(--font-headline, sans-serif);
  pointer-events: none;
  white-space: nowrap;
  transition: opacity 0.8s ease;
  animation: dome-hint-float 3s ease-in-out infinite;
}
.dome-drag-hint.hidden { opacity: 0; }
@keyframes dome-hint-float {
  0%, 100% { transform: translateX(-50%) translateY(0);   }
  50%       { transform: translateX(-50%) translateY(-6px); }
}

/* ── Expand overlay ──────────────────────────────────────────────── */
.dome-expand-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  background: rgba(5,15,25,0);
  backdrop-filter: blur(0px);
  -webkit-backdrop-filter: blur(0px);
  pointer-events: none;
  transition: background 0.35s ease, backdrop-filter 0.35s ease;
}
.dome-expand-overlay.open {
  background: rgba(5,15,25,0.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  pointer-events: all;
}
.dome-expand-card {
  position: relative;
  max-width: 360px;
  width: 100%;
  border-radius: 16px;
  overflow: hidden;
  background: #0a141e;
  border: 1px solid rgba(255,255,255,0.1);
  box-shadow: 0 32px 80px rgba(0,0,0,0.7);
  transform: translateY(28px) scale(0.94);
  opacity: 0;
  transition: transform 0.35s ease, opacity 0.35s ease;
}
.dome-expand-overlay.open .dome-expand-card {
  transform: translateY(0) scale(1);
  opacity: 1;
}
.dome-expand-img {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  display: block;
}
.dome-expand-footer {
  padding: 1.25rem;
  display: flex;
  justify-content: center;
}
.dome-expand-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-family: var(--font-headline, sans-serif);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #fff;
  background: #FF4655;
  border-radius: 6px;
  padding: 0.75rem 2rem;
  text-decoration: none;
  transition: background 0.15s ease;
}
.dome-expand-btn:hover { background: #ff6270; }
.dome-expand-close {
  position: absolute;
  top: 0.6rem;
  right: 0.6rem;
  z-index: 1;
  width: 30px; height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.55);
  border: none;
  border-radius: 50%;
  color: #fff;
  font-size: 0.8rem;
  cursor: pointer;
  line-height: 1;
}
</style>

<script>
(function () {
  var FIT      = 0.9;
  var MIN_R    = 1500;
  var SEG      = 22;
  var MAX_VERT = 20;
  var SENS     = 20;
  var DAMP     = 2;
  var AUTO_SPD = 0.025;

  function clamp(v, lo, hi) { return Math.min(Math.max(v, lo), hi); }
  function wrapAngle(deg) {
    var a = (((deg + 180) % 360) + 360) % 360;
    return a - 180;
  }

  function buildItems(pool, seg) {
    var xCols = [];
    for (var i = 0; i < seg; i++) xCols.push(-37 + i * 2);
    var evenYs = [-4, -2, 0, 2, 4];
    var oddYs  = [-3, -1, 1, 3, 5];
    var coords = [];
    xCols.forEach(function (x, c) {
      var ys = c % 2 === 0 ? evenYs : oddYs;
      ys.forEach(function (y) { coords.push({ x: x, y: y, sizeX: 2, sizeY: 2 }); });
    });
    if (!pool.length) return [];
    var used = coords.map(function (_, i) { return pool[i % pool.length]; });
    for (var i = 1; i < used.length; i++) {
      if (used[i].src === used[i - 1].src) {
        for (var j = i + 1; j < used.length; j++) {
          if (used[j].src !== used[i].src) {
            var tmp = used[i]; used[i] = used[j]; used[j] = tmp;
            break;
          }
        }
      }
    }
    return coords.map(function (c, i) {
      return { x: c.x, y: c.y, sizeX: 2, sizeY: 2,
               src: used[i].src, alt: used[i].alt, url: used[i].url };
    });
  }

  /* ── DOM ──────────────────────────────────────────────────────── */
  var root        = document.getElementById('dome-bg-{{ section.id }}');
  if (!root) return;
  var heroSection = document.getElementById('hero-banner-{{ section.id }}');
  var sphere      = root.querySelector('.sphere');
  var hint        = document.getElementById('dome-hint-{{ section.id }}');
  var expandOv    = document.getElementById('dome-expand-{{ section.id }}');
  var expandImg   = expandOv.querySelector('.dome-expand-img');
  var expandBtn   = expandOv.querySelector('.dome-expand-btn');
  var expandClose = expandOv.querySelector('.dome-expand-close');

  /* ── Images (with product URLs) ──────────────────────────────── */
  var images = [
    {%- for product in collections.all.products limit: 24 -%}
      {%- if product.featured_image != blank -%}
        { src: "{{ product.featured_image | image_url: width: 800 }}",
          alt: "{{ product.title | escape }}",
          url: "{{ product.url }}" },
      {%- endif -%}
    {%- endfor -%}
  ];
  if (!images.length) return;

  /* ── Build tiles ──────────────────────────────────────────────── */
  var lastDragEndAt = 0;
  var items = buildItems(images, SEG);

  items.forEach(function (it) {
    if (!it.src) return;
    var el = document.createElement('div');
    el.className = 'item';
    el.style.setProperty('--offset-x',    it.x);
    el.style.setProperty('--offset-y',    it.y);
    el.style.setProperty('--item-size-x', it.sizeX);
    el.style.setProperty('--item-size-y', it.sizeY);

    var imgDiv = document.createElement('div');
    imgDiv.className = 'item__image';

    var img = document.createElement('img');
    img.src = it.src;
    img.alt = it.alt;
    img.draggable = false;
    img.loading = 'lazy';

    /* click → go to product page (only if not a drag) */
    ;(function (url) {
      imgDiv.addEventListener('click', function (e) {
        if (performance.now() - lastDragEndAt < 120) return;
        e.stopPropagation();
        window.location.href = url;
      });
    }(it.url));

    imgDiv.appendChild(img);
    el.appendChild(imgDiv);
    sphere.appendChild(el);
  });

  /* ── Expand overlay ───────────────────────────────────────────── */
  function openExpand(src, alt, url) {
    expandImg.src = src;
    expandImg.alt = alt;
    expandBtn.href = url;
    expandOv.classList.add('open');
  }
  function closeExpand() {
    expandOv.classList.remove('open');
  }
  expandClose.addEventListener('click', closeExpand);
  expandOv.addEventListener('click', function (e) {
    if (e.target === expandOv) closeExpand();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeExpand();
  });

  /* ── State ────────────────────────────────────────────────────── */
  var rot      = { x: 0, y: 0 };
  var startRot = { x: 0, y: 0 };
  var startPos = null;
  var dragging = false;
  var moved    = false;
  var vX = 0, vY = 0;
  var prevPos  = null;
  var prevTime = 0;
  var inertiaRAF = null;
  var autoRAF    = null;
  var hintDismissed = false;

  function applyTransform(x, y) {
    sphere.style.transform =
      'translateZ(calc(var(--radius) * -1)) rotateX(' + x + 'deg) rotateY(' + y + 'deg)';
  }

  /* ── Auto-rotate ──────────────────────────────────────────────── */
  function stopAuto() {
    if (autoRAF) { cancelAnimationFrame(autoRAF); autoRAF = null; }
  }
  function startAuto() {
    if (autoRAF) return;
    function step() {
      if (dragging) { autoRAF = null; return; }
      rot.y = wrapAngle(rot.y + AUTO_SPD);
      applyTransform(rot.x, rot.y);
      autoRAF = requestAnimationFrame(step);
    }
    autoRAF = requestAnimationFrame(step);
  }

  /* ── Inertia ──────────────────────────────────────────────────── */
  function stopInertia() {
    if (inertiaRAF) { cancelAnimationFrame(inertiaRAF); inertiaRAF = null; }
  }
  function startInertia(vx, vy) {
    var MAX_V = 1.4;
    var iVX   = clamp(vx, -MAX_V, MAX_V) * 80;
    var iVY   = clamp(vy, -MAX_V, MAX_V) * 80;
    var frames = 0;
    var d = clamp(DAMP, 0, 1);
    var friction  = 0.94 + 0.055 * d;
    var threshold = 0.015 - 0.01 * d;
    var maxFrames = Math.round(90 + 270 * d);
    stopInertia(); stopAuto();
    function step() {
      iVX *= friction; iVY *= friction;
      if ((Math.abs(iVX) < threshold && Math.abs(iVY) < threshold) || ++frames > maxFrames) {
        inertiaRAF = null; startAuto(); return;
      }
      var nx = clamp(rot.x - iVY / 200, -MAX_VERT, MAX_VERT);
      var ny = wrapAngle(rot.y + iVX / 200);
      rot.x = nx; rot.y = ny;
      applyTransform(nx, ny);
      inertiaRAF = requestAnimationFrame(step);
    }
    inertiaRAF = requestAnimationFrame(step);
  }

  /* ── Pointer events ───────────────────────────────────────────── */
  heroSection.addEventListener('pointerdown', function (e) {
    stopInertia(); stopAuto();
    dragging = true; moved = false;
    startRot.x = rot.x; startRot.y = rot.y;
    startPos = { x: e.clientX, y: e.clientY };
    prevPos  = { x: e.clientX, y: e.clientY };
    prevTime = performance.now();
    vX = 0; vY = 0;
    /* dismiss hint on first interaction */
    if (!hintDismissed && hint) {
      hintDismissed = true;
      hint.classList.add('hidden');
    }
  });

  document.addEventListener('pointermove', function (e) {
    if (!dragging || !startPos) return;
    var dxT = e.clientX - startPos.x;
    var dyT = e.clientY - startPos.y;
    if (!moved && (dxT * dxT + dyT * dyT) > 16) moved = true;
    var now = performance.now();
    var dt  = Math.max(1, now - prevTime);
    vX = (e.clientX - prevPos.x) / dt;
    vY = (e.clientY - prevPos.y) / dt;
    prevPos  = { x: e.clientX, y: e.clientY };
    prevTime = now;
    rot.x = clamp(startRot.x - dyT / SENS, -MAX_VERT, MAX_VERT);
    rot.y = wrapAngle(startRot.y + dxT / SENS);
    applyTransform(rot.x, rot.y);
  });

  document.addEventListener('pointerup', function () {
    if (!dragging) return;
    dragging = false;
    if (moved && (Math.abs(vX) > 0.01 || Math.abs(vY) > 0.01)) {
      lastDragEndAt = performance.now();
      startInertia(vX, vY);
    } else {
      startAuto();
    }
    moved = false;
  });

  /* ── ResizeObserver ───────────────────────────────────────────── */
  new ResizeObserver(function (entries) {
    var cr = entries[0].contentRect;
    var w  = Math.max(1, cr.width);
    var h  = Math.max(1, cr.height);
    var basis  = w / h >= 1.3 ? w : Math.min(w, h);
    var radius = Math.max(basis * FIT, MIN_R);
    root.style.setProperty('--radius', Math.round(radius) + 'px');
    applyTransform(rot.x, rot.y);
  }).observe(root);

  applyTransform(0, 0);
  startAuto();
})();
</script>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Combat Ready Replicas"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading — wrap a word in | | to accent it",
      "default": "YOUR FAVORITE |SKINS|, IRL"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Valorant-inspired melee knives and weapon keychains. Crafted for collectors, built to carry."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button text",
      "default": "SHOP THE ARMORY"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA button link"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured collection (right panel)"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "settings": {
        "eyebrow": "Combat Ready Replicas",
        "heading": "YOUR FAVORITE |SKINS|, IRL",
        "subtitle": "Valorant-inspired melee knives and weapon keychains. Crafted for collectors, built to carry.",
        "cta_label": "SHOP THE ARMORY"
      }
    }
  ]
}
{% endschema %}
