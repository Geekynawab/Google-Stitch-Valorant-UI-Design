<section class="hero-banner" id="hero-banner-{{ section.id }}">

  <!-- DomeGallery React mount point -->
  <div id="dome-react-{{ section.id }}" class="dome-react-mount" aria-hidden="true"></div>

  <!-- Hint -->
  <div class="dome-drag-hint" id="dome-hint-{{ section.id }}" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 9l6 6 6-6"/>
      <circle cx="12" cy="5" r="2"/>
      <path d="M4 20h16"/>
    </svg>
    <span>click any tile to shop</span>
  </div>

  <div class="hero-banner__overlay"></div>

  <div class="container">
    <div class="hero-banner__inner">

      <!-- Left: Text content -->
      <div class="hero-banner__content">
        {%- if section.settings.heading != blank -%}
          <h1 class="hero-banner__title glitch" data-text="{{ section.settings.heading | split: '|' | join: '' | strip_html }}">
            {%- assign title_parts = section.settings.heading | split: '|' -%}
            {%- if title_parts.size > 1 -%}
              {{ title_parts[0] }}<em>{{ title_parts[1] }}</em>{{ title_parts[2] }}
            {%- else -%}
              {{ section.settings.heading }}
            {%- endif -%}
          </h1>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="hero-banner__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
        <div class="hero-banner__actions">
          {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
            <a href="{{ section.settings.cta_link }}" class="btn-primary">{{ section.settings.cta_label }}</a>
          {%- endif -%}
          <a href="{{ section.settings.shop_link | default: '/collections/all' }}" class="btn-primary">
            {{ section.settings.shop_label | default: 'Shop Collection' }}
          </a>
        </div>
      </div>

      <!-- Right: Featured collection panel -->
      {%- if section.settings.featured_collection != blank -%}
        {%- assign feat = collections[section.settings.featured_collection] -%}
        {%- if feat != blank -%}
          <div class="hero-banner__panel">
            <p class="hero-panel__label">{{ feat.title | upcase }}</p>
            <div class="hero-panel__grid">
              {%- for product in feat.products limit: 4 -%}
                <a href="{{ product.url }}" class="hero-panel__item">
                  {%- if product.featured_image -%}
                    <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy" width="300" height="300">
                  {%- endif -%}
                  <span class="hero-panel__item-title">{{ product.title }}</span>
                </a>
              {%- endfor -%}
            </div>
            <a href="{{ feat.url }}" class="hero-panel__more">View all &rarr;</a>
          </div>
        {%- endif -%}
      {%- endif -%}

    </div>
  </div>
</section>

<!-- Shopify product data passed to React (outside raw block so Liquid processes it) -->
<script id="dome-data-{{ section.id }}" type="application/json">
{
  "sectionId": {{ section.id | json }},
  "images": [
    {%- assign _first = true -%}
    {%- for product in collections.all.products limit: 24 -%}
      {%- if product.featured_image != blank -%}
        {%- unless _first -%},{%- endunless -%}
        {"src":{{ product.featured_image | image_url: width: 800 | json }},"alt":{{ product.title | json }},"url":{{ product.url | json }}}
        {%- assign _first = false -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>

<style>
/* ── Dome mount ─────────────────────────────────────────────────────── */
.dome-react-mount {
  position: absolute;
  inset: 0 -12vw;
  z-index: 0;
}

/* ── DomeGallery CSS (ReactBits) ────────────────────────────────────── */
.sphere-root {
  position: relative;
  width: 100%;
  height: 100%;
  --radius: 1500px;
  --circ: calc(var(--radius) * 3.14159);
  --rot-y: calc((360deg / var(--segments-x, 22)) / 2);
  --rot-x: calc((360deg / var(--segments-y, 22)) / 2);
  --item-width:  calc(var(--circ) / var(--segments-x, 22));
  --item-height: calc(var(--circ) / var(--segments-y, 22));
}
.sphere-root * { box-sizing: border-box; }
.sphere, .item, .item__image { transform-style: preserve-3d; }
.sphere-main {
  position: absolute; inset: 0;
  display: grid; place-items: center;
  overflow: hidden; touch-action: none;
  user-select: none; -webkit-user-select: none;
  background: transparent;
}
.stage {
  width: 100%; height: 100%;
  display: grid; place-items: center;
  perspective: calc(var(--radius) * 2);
  perspective-origin: 50% 50%;
  contain: layout paint size;
}
.sphere {
  transform: translateZ(calc(var(--radius) * -1));
  will-change: transform;
}
.item {
  width:  calc(var(--item-width)  * var(--item-size-x, 2));
  height: calc(var(--item-height) * var(--item-size-y, 2));
  position: absolute;
  top: -999px; bottom: -999px; left: -999px; right: -999px;
  margin: auto; transform-origin: 50% 50%;
  backface-visibility: hidden;
  pointer-events: none;
  transform:
    rotateY(calc(var(--rot-y) * (var(--offset-x, 0) + (var(--item-size-x, 2) - 1) / 2)))
    rotateX(calc(var(--rot-x) * (var(--offset-y, 0) - (var(--item-size-y, 2) - 1) / 2)))
    translateZ(var(--radius));
}
.item__image {
  position: absolute; inset: 2px;
  border-radius: var(--tile-radius, 12px);
  overflow: hidden; backface-visibility: hidden;
  pointer-events: auto; cursor: pointer;
  transition: filter 0.2s ease;
}
.item__image:hover { filter: brightness(1.25); }
.item__image img {
  width: 100%; height: 100%; object-fit: cover;
  pointer-events: none; backface-visibility: hidden;
  filter: var(--image-filter, brightness(0.5));
}
.edge-fade { position: absolute; z-index: 5; pointer-events: none; }
.edge-fade--top    { top: 0; left: 0; right: 0; height: 220px;
  background: linear-gradient(to bottom, var(--overlay-blur-color, #000), transparent); }
.edge-fade--bottom { bottom: 0; left: 0; right: 0; height: 220px;
  background: linear-gradient(to top, var(--overlay-blur-color, #000), transparent); }
.edge-fade--left   { top: 0; bottom: 0; left: 0; width: 10vw;
  background: linear-gradient(to right, var(--overlay-blur-color, #000), transparent); }
.edge-fade--right  { top: 0; bottom: 0; right: 0; width: 10vw;
  background: linear-gradient(to left, var(--overlay-blur-color, #000), transparent); }

/* ── Hero layout ────────────────────────────────────────────────────── */
.hero-banner {
  position: relative; overflow: hidden;
  min-height: 100svh; display: flex; flex-direction: column; justify-content: center;
  background: var(--color-surface);
}
.hero-banner__overlay {
  position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background: linear-gradient(to right, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.2) 60%, transparent 100%);
}
.hero-banner__inner {
  position: relative; z-index: 2;
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--space-12); padding: var(--space-24) 0;
}
.hero-banner__content { flex: 0 0 auto; max-width: 520px; }
.hero-banner__eyebrow {
  display: inline-block; margin-bottom: var(--space-4);
  font-size: 0.7rem; font-weight: 700; letter-spacing: 0.22em;
  text-transform: uppercase; color: var(--color-accent-teal);
}
.hero-banner__eyebrow::before {
  content: ''; display: block; width: 32px; height: 2px;
  background-color: var(--color-accent-teal); margin-bottom: var(--space-2);
}
.hero-banner__title {
  font-family: var(--font-valorant);
  font-size: clamp(2.4rem, 5vw, 4.2rem);
  line-height: 1.05; font-weight: 400;
  text-transform: uppercase; letter-spacing: 0.03em;
  color: var(--color-text-primary); margin-bottom: var(--space-6);
  position: relative;
}
.hero-banner__title em { font-style: normal; color: var(--color-primary); }
.hero-banner__subtitle {
  font-size: 1.2rem; line-height: 1.6; color: var(--color-on-surface-variant);
  margin-bottom: 1.75rem; font-family: var(--font-body);
}
.hero-banner__actions { display: flex; gap: var(--space-4); flex-wrap: wrap; }
.hero-banner__panel {
  flex: 0 0 auto; width: 300px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--radius-md); padding: var(--space-6);
  backdrop-filter: blur(8px);
}
.hero-panel__label {
  font-family: var(--font-headline); font-size: 0.65rem; font-weight: 700;
  letter-spacing: 0.18em; color: var(--color-primary); margin: 0 0 var(--space-4);
}
.hero-panel__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); margin-bottom: var(--space-4); }
.hero-panel__item {
  display: flex; flex-direction: column; gap: var(--space-2);
  border: 1px solid rgba(255,255,255,0.06); border-radius: var(--radius-sm);
  overflow: hidden; text-decoration: none; transition: border-color 0.2s;
}
.hero-panel__item:hover { border-color: var(--color-primary); transform: translateY(-2px); }
.hero-panel__item img { width: 100%; aspect-ratio: 1/1; object-fit: cover; display: block; }
.hero-panel__item-title {
  font-family: var(--font-headline); font-size: 0.6rem; font-weight: 700;
  letter-spacing: 0.05em; text-transform: uppercase; color: #fff; padding: var(--space-1) var(--space-2);
}
.hero-panel__more {
  font-family: var(--font-headline); font-size: 0.7rem; font-weight: 600;
  letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-primary);
  text-decoration: none; display: block; text-align: right;
}
.hero-panel__more:hover { color: var(--color-primary-container); }
@media (max-width: 900px) {
  .hero-banner__inner { flex-direction: column; align-items: flex-start; }
  .hero-banner__panel { width: 100%; }
}

/* ── Glitch animation ───────────────────────────────────────────────── */
@keyframes glitch-1 {
  0%, 100% { clip-path: inset(98% 0 0 0); transform: translate(2px, 0); color: var(--color-accent-teal); }
  25% { clip-path: inset(20% 0 60% 0); transform: translate(-2px, 0); }
  50% { clip-path: inset(60% 0 10% 0); transform: translate(2px, 0); }
  75% { clip-path: inset(40% 0 40% 0); transform: translate(-2px, 0); }
}
@keyframes glitch-2 {
  0%, 100% { clip-path: inset(0 0 98% 0); transform: translate(-2px, 0); }
  25% { clip-path: inset(60% 0 20% 0); transform: translate(2px, 0); }
  50% { clip-path: inset(10% 0 70% 0); transform: translate(-2px, 0); }
  75% { clip-path: inset(70% 0 10% 0); transform: translate(2px, 0); }
}
.glitch { position: relative; }
.glitch::before, .glitch::after {
  content: attr(data-text); position: absolute; inset: 0;
  color: var(--color-primary); pointer-events: none;
}
.glitch::before { animation: glitch-1 4s infinite linear; }
.glitch::after  { animation: glitch-2 4s infinite linear 0.1s; }

/* ── Trust bar ──────────────────────────────────────────────────────── */
.trust-bar { border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: 0.75rem 0; background: var(--color-surface-container-low); }
.trust-bar__list { display: flex; flex-wrap: wrap; justify-content: center; }
.trust-bar__item { display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 1.5rem; }
.trust-bar__item + .trust-bar__item { border-left: 1px solid var(--color-border); }
.trust-bar__icon { color: var(--color-on-surface); opacity: 0.85; flex-shrink: 0; }
.trust-bar__title { font-size: 0.75rem; font-weight: 700; color: var(--color-on-surface); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 0.1rem; }
.trust-bar__text  { font-size: 0.7rem; color: var(--color-text-secondary); line-height: 1.4; }
@media (max-width: 600px) {
  .trust-bar__item + .trust-bar__item { border-left: none; border-top: 1px solid var(--color-border); }
}

/* ── Drag hint ──────────────────────────────────────────────────────── */
.dome-drag-hint {
  position: absolute; bottom: 1.75rem; left: 50%;
  transform: translateX(-50%); z-index: 10;
  color: rgba(255,255,255,0.92);
  background: rgba(0,0,0,0.55);
  border: 1px solid rgba(255,255,255,0.25);
  padding: 0.55rem 1.25rem; border-radius: 999px;
  display: flex; align-items: center; gap: 0.6rem;
  font-size: 0.82rem; letter-spacing: 0.18em; text-transform: uppercase;
  font-family: var(--font-headline, sans-serif);
  pointer-events: none; white-space: nowrap;
  transition: opacity 0.8s ease;
  animation: dome-hint-float 3s ease-in-out infinite;
}
.dome-drag-hint.hidden { opacity: 0; }
@keyframes dome-hint-float {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50%       { transform: translateX(-50%) translateY(-6px); }
}
</style>

{% raw %}
<script type="text/babel" data-presets="react">
(function () {
  const { useEffect, useRef, useMemo, useCallback } = React;

  const clamp = (v, lo, hi) => Math.min(Math.max(v, lo), hi);
  const wrapAngleSigned = (deg) => { const a = (((deg + 180) % 360) + 360) % 360; return a - 180; };

  function buildItems(pool, seg) {
    const xCols = Array.from({ length: seg }, (_, i) => -37 + i * 2);
    const evenYs = [-4, -2, 0, 2, 4];
    const oddYs  = [-3, -1, 1, 3, 5];
    const coords = xCols.flatMap((x, c) => (c % 2 === 0 ? evenYs : oddYs).map(y => ({ x, y, sizeX: 1.4, sizeY: 1.4 })));
    if (!pool.length) return coords.map(c => ({ ...c, src: '', alt: '', url: '#' }));
    const used = Array.from({ length: coords.length }, (_, i) => pool[i % pool.length]);
    for (let i = 1; i < used.length; i++) {
      if (used[i].src === used[i - 1].src) {
        for (let j = i + 1; j < used.length; j++) {
          if (used[j].src !== used[i].src) { [used[i], used[j]] = [used[j], used[i]]; break; }
        }
      }
    }
    return coords.map((c, i) => ({ ...c, ...used[i] }));
  }

  function DomeGallery({ images, fit = 0.9, minRadius = 1500, segments = 22, maxVertVert = 20, sens = 20, damp = 2, blurColor = '#000000', tileRadius = '12px', grayscale = false, hintId }) {
    const rootRef   = useRef(null);
    const mainRef   = useRef(null);
    const sphereRef = useRef(null);
    const rot       = useRef({ x: 0, y: 0 });
    const startRot  = useRef({ x: 0, y: 0 });
    const startPos  = useRef(null);
    const prevPos   = useRef(null);
    const prevTime  = useRef(0);
    const vel       = useRef({ x: 0, y: 0 });
    const dragging  = useRef(false);
    const moved     = useRef(false);
    const inertiaId = useRef(null);
    const autoId    = useRef(null);
    const lastDrag  = useRef(0);

    const items = useMemo(() => buildItems(images, segments), [images, segments]);

    const applyTransform = useCallback((x, y) => {
      if (sphereRef.current)
        sphereRef.current.style.transform = `translateZ(calc(var(--radius) * -1)) rotateX(${x}deg) rotateY(${y}deg)`;
    }, []);

    /* ResizeObserver */
    useEffect(() => {
      const root = rootRef.current;
      if (!root) return;
      const ro = new ResizeObserver(([e]) => {
        const { width: w, height: h } = e.contentRect;
        const basis = w / h >= 1.3 ? w : Math.min(w, h);
        const r = Math.max(basis * fit, minRadius);
        root.style.setProperty('--radius', Math.round(r) + 'px');
        root.style.setProperty('--segments-x', segments);
        root.style.setProperty('--segments-y', segments);
        root.style.setProperty('--overlay-blur-color', blurColor);
        root.style.setProperty('--tile-radius', tileRadius);
        root.style.setProperty('--image-filter', grayscale ? 'grayscale(1)' : 'brightness(0.5)');
        applyTransform(rot.current.x, rot.current.y);
      });
      ro.observe(root);
      return () => ro.disconnect();
    }, [fit, minRadius, segments, blurColor, tileRadius, grayscale, applyTransform]);

    /* Auto-rotate */
    const stopAuto = useCallback(() => { if (autoId.current) { cancelAnimationFrame(autoId.current); autoId.current = null; } }, []);
    const startAuto = useCallback(() => {
      if (autoId.current) return;
      const step = () => {
        if (dragging.current) { autoId.current = null; return; }
        rot.current.y = wrapAngleSigned(rot.current.y + 0.01);
        applyTransform(rot.current.x, rot.current.y);
        autoId.current = requestAnimationFrame(step);
      };
      autoId.current = requestAnimationFrame(step);
    }, [applyTransform]);

    /* Inertia */
    const stopInertia = useCallback(() => { if (inertiaId.current) { cancelAnimationFrame(inertiaId.current); inertiaId.current = null; } }, []);
    const startInertia = useCallback((vx, vy) => {
      let iX = clamp(vx, -1.4, 1.4) * 80, iY = clamp(vy, -1.4, 1.4) * 80, frames = 0;
      const d = clamp(damp, 0, 1), friction = 0.94 + 0.055 * d, thr = 0.015 - 0.01 * d, max = Math.round(90 + 270 * d);
      stopInertia(); stopAuto();
      const step = () => {
        iX *= friction; iY *= friction;
        if ((Math.abs(iX) < thr && Math.abs(iY) < thr) || ++frames > max) { inertiaId.current = null; startAuto(); return; }
        const nx = clamp(rot.current.x - iY / 200, -maxVertVert, maxVertVert);
        const ny = wrapAngleSigned(rot.current.y + iX / 200);
        rot.current = { x: nx, y: ny };
        applyTransform(nx, ny);
        inertiaId.current = requestAnimationFrame(step);
      };
      inertiaId.current = requestAnimationFrame(step);
    }, [damp, maxVertVert, stopInertia, stopAuto, startAuto, applyTransform]);

    /* Pointer events (replaces @use-gesture/react) */
    useEffect(() => {
      const el = mainRef.current;
      if (!el) return;
      const onDown = (e) => {
        stopInertia(); stopAuto();
        dragging.current = true; moved.current = false;
        startRot.current = { ...rot.current };
        startPos.current = prevPos.current = { x: e.clientX, y: e.clientY };
        prevTime.current = performance.now(); vel.current = { x: 0, y: 0 };
        if (hintId) { const h = document.getElementById(hintId); if (h) h.classList.add('hidden'); }
      };
      const onMove = (e) => {
        if (!dragging.current || !startPos.current) return;
        const dx = e.clientX - startPos.current.x, dy = e.clientY - startPos.current.y;
        if (!moved.current && dx * dx + dy * dy > 16) moved.current = true;
        const dt = Math.max(1, performance.now() - prevTime.current);
        vel.current = { x: (e.clientX - prevPos.current.x) / dt, y: (e.clientY - prevPos.current.y) / dt };
        prevPos.current = { x: e.clientX, y: e.clientY }; prevTime.current = performance.now();
        rot.current = {
          x: clamp(startRot.current.x - dy / sens, -maxVertVert, maxVertVert),
          y: wrapAngleSigned(startRot.current.y + dx / sens)
        };
        applyTransform(rot.current.x, rot.current.y);
      };
      const onUp = () => {
        if (!dragging.current) return;
        dragging.current = false;
        const { x: vx, y: vy } = vel.current;
        if (moved.current && (Math.abs(vx) > 0.01 || Math.abs(vy) > 0.01)) { lastDrag.current = performance.now(); startInertia(vx, vy); }
        else startAuto();
        moved.current = false;
      };
      el.addEventListener('pointerdown', onDown, { passive: true });
      document.addEventListener('pointermove', onMove, { passive: true });
      document.addEventListener('pointerup', onUp);
      return () => {
        el.removeEventListener('pointerdown', onDown);
        document.removeEventListener('pointermove', onMove);
        document.removeEventListener('pointerup', onUp);
      };
    }, [sens, maxVertVert, stopInertia, stopAuto, startInertia, startAuto, applyTransform, hintId]);

    /* Init */
    useEffect(() => {
      applyTransform(0, 0); startAuto();
      return () => { stopInertia(); stopAuto(); };
    }, [applyTransform, startAuto, stopInertia, stopAuto]);

    const onTileClick = useCallback((e, url) => {
      if (moved.current) return;
      if (performance.now() - lastDrag.current < 80) return;
      e.stopPropagation();
      window.location.href = url;
    }, []);

    return (
      <div ref={rootRef} className="sphere-root">
        <main ref={mainRef} className="sphere-main">
          <div className="stage">
            <div ref={sphereRef} className="sphere">
              {items.map((it, i) => it.src ? (
                <div key={`${it.x},${it.y},${i}`} className="item" style={{ '--offset-x': it.x, '--offset-y': it.y, '--item-size-x': it.sizeX, '--item-size-y': it.sizeY }}>
                  <div className="item__image" onClick={(e) => onTileClick(e, it.url)}>
                    <img src={it.src} alt={it.alt} draggable={false} loading="lazy" />
                  </div>
                </div>
              ) : null)}
            </div>
          </div>
          <div className="edge-fade edge-fade--top" />
          <div className="edge-fade edge-fade--bottom" />
          <div className="edge-fade edge-fade--left" />
          <div className="edge-fade edge-fade--right" />
        </main>
      </div>
    );
  }

  /* Mount all uninitialized dome galleries on the page */
  document.querySelectorAll('script[id^="dome-data-"]:not([data-initialized])').forEach(dataEl => {
    dataEl.setAttribute('data-initialized', 'true');
    const { sectionId, images } = JSON.parse(dataEl.textContent);
    const container = document.getElementById('dome-react-' + sectionId);
    if (!container || !images.length) return;
    ReactDOM.createRoot(container).render(
      <DomeGallery
        images={images}
        fit={0.9}
        minRadius={1500}
        segments={22}
        maxVertVert={20}
        sens={20}
        damp={2}
        blurColor="#000000"
        tileRadius="12px"
        grayscale={false}
        hintId={'dome-hint-' + sectionId}
      />
    );
  });
})();
</script>
{% endraw %}

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Combat Ready Replicas"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading — wrap a word in | | to accent it",
      "default": "YOUR FAVORITE |SKINS|, IRL"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Valorant-inspired melee knives and weapon keychains. Crafted for collectors, built to carry."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button text",
      "default": "SHOP THE ARMORY"
    },
    {
