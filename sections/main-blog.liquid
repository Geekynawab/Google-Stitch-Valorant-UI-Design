<div class="container">{% render 'breadcrumb' %}</div>

<div class="collection-header">
  <div class="container">
    <div class="blog-header-inner">
      <span class="blog-header__label">// DISPATCH</span>
      <h1>{{ blog.title | upcase }}</h1>
    </div>
  </div>
</div>

<section class="section blog-section">
  <div class="container">

    {%- paginate blog.articles by 12 -%}

      {%- if blog.articles.size == 0 -%}
        <p class="collection-empty">No dispatches yet. Stand by.</p>
      {%- else -%}
        <div class="blog-grid">
          {%- for article in blog.articles -%}

            {%- comment -%} Derive patch number from tag (patch:X.XX) or fallback to date {%- endcomment -%}
            {%- assign patch_num = nil -%}
            {%- for tag in article.tags -%}
              {%- if tag contains 'patch:' -%}{%- assign patch_num = tag | remove: 'patch:' -%}{%- endif -%}
            {%- endfor -%}
            {%- assign patch_num = patch_num | default: article.published_at | date: '%y.%m' -%}

            <a href="{{ article.url }}" class="blog-card">

              <div class="blog-card__img-wrap">
                {%- if article.image -%}
                  <img src="{{ article.image | image_url: width: 700 }}"
                       alt="{{ article.image.alt | escape | default: article.title }}"
                       loading="lazy" width="700" height="467">
                {%- else -%}
                  <div class="blog-card__img-placeholder"></div>
                {%- endif -%}
                {%- assign _date_fallback = article.published_at | date: '%y.%m' -%}
                {%- unless patch_num == _date_fallback -%}
                  <div class="blog-card__patch-badge">v{{ patch_num }}</div>
                {%- endunless -%}
              </div>

              <div class="blog-card__body">
                <span class="blog-card__date">{{ article.published_at | date: '%b %d, %Y' }}</span>
                <h2 class="blog-card__title">{{ article.title }}</h2>
                {%- if article.excerpt != blank -%}
                  <p class="blog-card__excerpt">{{ article.excerpt | strip_html | truncate: 110 }}</p>
                {%- endif -%}
                <span class="blog-card__read-more">Read more &rarr;</span>
              </div>

            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr;</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}<span{%- if part.title == paginate.current_page %} class="current"{%- endif -%}>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">&rarr;</a>{%- endif -%}
        </nav>
      {%- endif -%}

    {%- endpaginate -%}

  </div>
</section>

{% schema %}
{ "name": "Blog Page" }
{% endschema %}
