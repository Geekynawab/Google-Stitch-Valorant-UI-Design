<!-- Collection header -->
<div class="collection-header">
  <div class="container">
    <div class="collection-header__eyebrow">
      <span style="height:2px;width:3rem;background:var(--color-primary);display:inline-block;vertical-align:middle;margin-right:1rem;"></span>
      <span class="label" style="color:var(--color-primary);">{{ collection.title }}</span>
    </div>
    <h1>{{ collection.title }}</h1>
    <p class="collection-header__meta">{{ collection.products_count }} PRODUCTS</p>
  </div>
</div>

<!-- Filter bar -->
{%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
{%- assign current_tag = current_tags | first -%}
{%- assign grp1 = section.settings.group_1_tags | split: ',' -%}
{%- assign grp2 = section.settings.group_2_tags | split: ',' -%}
{%- assign grp3 = section.settings.group_3_tags | split: ',' -%}
{%- assign grp4 = section.settings.group_4_tags | split: ',' -%}

{%- comment -%} Collection button label {%- endcomment -%}
{%- assign coll_btn_label = section.settings.group_1_label -%}
{%- for t in grp1 -%}{%- assign tc = t | strip -%}{%- if tc != blank and current_tags contains tc -%}{%- assign coll_btn_label = tc -%}{%- endif -%}{%- endfor -%}

{%- comment -%} Weapon button label — default to Knife (group 3) {%- endcomment -%}
{%- assign weapon_btn_label = section.settings.group_3_label -%}
{%- for t in grp3 -%}{%- assign tc = t | strip -%}{%- if tc != blank and current_tags contains tc -%}{%- assign weapon_btn_label = tc -%}{%- endif -%}{%- endfor -%}
{%- for t in grp2 -%}{%- assign tc = t | strip -%}{%- if tc != blank and current_tags contains tc -%}{%- assign weapon_btn_label = tc -%}{%- endif -%}{%- endfor -%}
{%- for t in grp4 -%}{%- assign tc = t | strip -%}{%- if tc != blank and current_tags contains tc -%}{%- assign weapon_btn_label = tc -%}{%- endif -%}{%- endfor -%}

{%- comment -%} Sort button label {%- endcomment -%}
{%- assign sort_label = 'Relevance' -%}
{%- if sort_by == 'best-selling' -%}{%- assign sort_label = 'Best Selling' -%}
{%- elsif sort_by == 'price-ascending' -%}{%- assign sort_label = 'Low → High' -%}
{%- elsif sort_by == 'price-descending' -%}{%- assign sort_label = 'High → Low' -%}
{%- elsif sort_by == 'created-descending' -%}{%- assign sort_label = 'Newest' -%}
{%- elsif sort_by == 'title-ascending' -%}{%- assign sort_label = 'A – Z' -%}
{%- endif -%}

<div class="collection-filter-bar">
  <div class="container">
    <div class="collection-filter-bar__inner">

      <!-- Active filter clear badge -->
      {%- if current_tag -%}
        <a href="{{ collection.url }}" class="filter-clear">
          <span class="material-symbols-outlined" style="font-size:14px;vertical-align:middle;">close</span>
          {{ current_tag }}
        </a>
      {%- endif -%}

      <!-- Collection dropdown -->
      {%- if section.settings.group_1_label != blank and grp1.size > 0 -%}
        <div class="valo-dropdown" data-collection="{{ collection.url }}">
          <button class="valo-dropdown__btn" aria-expanded="false" aria-haspopup="listbox">
            {{ coll_btn_label | upcase }}
            <span class="material-symbols-outlined" style="font-size:18px;line-height:1;">arrow_drop_down</span>
          </button>
          <ul class="valo-dropdown__menu" role="listbox">
            {%- for tag in grp1 -%}
              {%- assign t = tag | strip -%}
              {%- if t != blank -%}
                <li>
                  <a href="{{ collection.url }}/{{ t | handle }}"
                     class="{% if current_tags contains t %}valo-dropdown__item--active{% endif %}">
                    {{ t }}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <!-- Weapon type dropdown (Knife first, then Rifle, then Other) -->
      <div class="valo-dropdown" data-collection="{{ collection.url }}">
        <button class="valo-dropdown__btn" aria-expanded="false" aria-haspopup="listbox">
          {{ weapon_btn_label | upcase }}
          <span class="material-symbols-outlined" style="font-size:18px;line-height:1;">arrow_drop_down</span>
        </button>
        <ul class="valo-dropdown__menu" role="listbox">

          {%- if section.settings.group_3_label != blank and grp3.size > 0 -%}
            <li class="valo-dropdown__sep">{{ section.settings.group_3_label }}</li>
            {%- for tag in grp3 -%}
              {%- assign t = tag | strip -%}
              {%- if t != blank -%}
                <li><a href="{{ collection.url }}/{{ t | handle }}" class="{% if current_tags contains t %}valo-dropdown__item--active{% endif %}">{{ t }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- if section.settings.group_2_label != blank and grp2.size > 0 -%}
            <li class="valo-dropdown__sep">{{ section.settings.group_2_label }}</li>
            {%- for tag in grp2 -%}
              {%- assign t = tag | strip -%}
              {%- if t != blank -%}
                <li><a href="{{ collection.url }}/{{ t | handle }}" class="{% if current_tags contains t %}valo-dropdown__item--active{% endif %}">{{ t }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- if section.settings.group_4_label != blank and grp4.size > 0 -%}
            <li class="valo-dropdown__sep">{{ section.settings.group_4_label }}</li>
            {%- for tag in grp4 -%}
              {%- assign t = tag | strip -%}
              {%- if t != blank -%}
                <li><a href="{{ collection.url }}/{{ t | handle }}" class="{% if current_tags contains t %}valo-dropdown__item--active{% endif %}">{{ t }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

        </ul>
      </div>

      <!-- Spacer -->
      <div style="flex:1;"></div>

      <!-- Sort dropdown -->
      <div class="valo-dropdown valo-dropdown--right">
        <button class="valo-dropdown__btn" aria-expanded="false" aria-haspopup="listbox">
          {{ sort_label | upcase }}
          <span class="material-symbols-outlined" style="font-size:18px;line-height:1;">arrow_drop_down</span>
        </button>
        <ul class="valo-dropdown__menu" role="listbox">
          <li><a href="#" data-sort-val="relevance"          class="{% if sort_by == 'relevance' %}valo-dropdown__item--active{% endif %}">Relevance</a></li>
          <li><a href="#" data-sort-val="best-selling"       class="{% if sort_by == 'best-selling' %}valo-dropdown__item--active{% endif %}">Best Selling</a></li>
          <li><a href="#" data-sort-val="price-ascending"    class="{% if sort_by == 'price-ascending' %}valo-dropdown__item--active{% endif %}">Price: Low to High</a></li>
          <li><a href="#" data-sort-val="price-descending"   class="{% if sort_by == 'price-descending' %}valo-dropdown__item--active{% endif %}">Price: High to Low</a></li>
          <li><a href="#" data-sort-val="created-descending" class="{% if sort_by == 'created-descending' %}valo-dropdown__item--active{% endif %}">Newest</a></li>
          <li><a href="#" data-sort-val="title-ascending"    class="{% if sort_by == 'title-ascending' %}valo-dropdown__item--active{% endif %}">A – Z</a></li>
        </ul>
      </div>

    </div>
  </div>
</div>

<!-- Product grid -->
<section class="section collection-grid-section">
  <div class="container">

    {%- paginate collection.products by section.settings.products_per_page -%}

      {%- if collection.products.size == 0 -%}
        <p class="collection-empty">No products found.</p>
      {%- else -%}
        <div class="collection-grid">
          {%- for product in collection.products -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr;</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span {%- if part.title == paginate.current_page %} class="current"{%- endif -%}>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">&rarr;</a>{%- endif -%}
        </nav>
      {%- endif -%}

    {%- endpaginate -%}

  </div>
</section>

<script>
  // Toggle all valo dropdowns
  document.querySelectorAll('.valo-dropdown').forEach(function (dd) {
    var btn = dd.querySelector('.valo-dropdown__btn');
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var opening = !dd.classList.contains('is-open');
      // close all first
      document.querySelectorAll('.valo-dropdown.is-open').forEach(function (x) {
        x.classList.remove('is-open');
        x.querySelector('.valo-dropdown__btn').setAttribute('aria-expanded', 'false');
      });
      if (opening) {
        dd.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
  document.addEventListener('click', function () {
    document.querySelectorAll('.valo-dropdown.is-open').forEach(function (dd) {
      dd.classList.remove('is-open');
      dd.querySelector('.valo-dropdown__btn').setAttribute('aria-expanded', 'false');
    });
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.valo-dropdown.is-open').forEach(function (dd) {
        dd.classList.remove('is-open');
        dd.querySelector('.valo-dropdown__btn').setAttribute('aria-expanded', 'false');
      });
    }
  });

  // Sort items
  document.querySelectorAll('[data-sort-val]').forEach(function (a) {
    a.addEventListener('click', function (e) {
      e.preventDefault();
      var url = new URL(window.location.href);
      url.searchParams.set('sort_by', this.dataset.sortVal);
      window.location = url.toString();
    });
  });
</script>

{% schema %}
{
  "name": "Collection Page",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8, "max": 48, "step": 4,
      "default": 12
    },
    { "type": "header", "content": "Filter Group 1 — Collections" },
    { "type": "text", "id": "group_1_label", "label": "Group label", "default": "Collection" },
    { "type": "text", "id": "group_1_tags",  "label": "Tags (comma-separated)", "default": "Reaver, Prime, Elderflame, Glitchpop" },
    { "type": "header", "content": "Filter Group 2 — Rifles" },
    { "type": "text", "id": "group_2_label", "label": "Group label", "default": "Rifle" },
    { "type": "text", "id": "group_2_tags",  "label": "Tags (comma-separated)", "default": "Vandal, Phantom, Spectre, Bulldog" },
    { "type": "header", "content": "Filter Group 3 — Knives (shown first)" },
    { "type": "text", "id": "group_3_label", "label": "Group label", "default": "Knife" },
    { "type": "text", "id": "group_3_tags",  "label": "Tags (comma-separated)", "default": "Karambit, Kunai, Butterfly" },
    { "type": "header", "content": "Filter Group 4 — Other" },
    { "type": "text", "id": "group_4_label", "label": "Group label", "default": "Type" },
    { "type": "text", "id": "group_4_tags",  "label": "Tags (comma-separated)", "default": "Keychain" }
  ]
}
{% endschema %}
