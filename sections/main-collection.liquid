<!-- Collection header -->
<div class="collection-header">
  <div class="container">
    <div class="collection-header__eyebrow">
      <span style="height:2px;width:3rem;background:var(--color-primary);display:inline-block;vertical-align:middle;margin-right:1rem;"></span>
      <span class="label" style="color:var(--color-primary);">{{ collection.title }}</span>
    </div>
    <h1>{{ collection.title }}</h1>
    <p class="collection-header__meta">{{ collection.products_count }} PRODUCTS</p>
  </div>
</div>

<!-- Filter bar -->
{%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
{%- assign current_tag = current_tags | first -%}

<div class="collection-filter-bar">
  <div class="container">
    <div class="collection-filter-bar__inner">

      <!-- Active filter badge + clear -->
      {%- if current_tag -%}
        <a href="{{ collection.url }}" class="filter-clear">
          <span class="material-symbols-outlined" style="font-size:14px;vertical-align:middle;">close</span>
          {{ current_tag }}
        </a>
      {%- endif -%}

      <!-- Group dropdowns -->
      {%- assign groups = '1,2,3,4' | split: ',' -%}
      {%- for g in groups -%}
        {%- assign label_key = 'group_' | append: g | append: '_label' -%}
        {%- assign tags_key  = 'group_' | append: g | append: '_tags' -%}
        {%- assign grp_label = section.settings[label_key] -%}
        {%- assign grp_tags  = section.settings[tags_key] | split: ',' -%}
        {%- if grp_label != blank and grp_tags.size > 0 -%}
          <select class="filter-group-select filter-sort-select"
                  data-collection="{{ collection.url }}"
                  aria-label="Filter by {{ grp_label }}">
            <option value="">{{ grp_label }}</option>
            {%- for tag in grp_tags -%}
              {%- assign t = tag | strip -%}
              {%- if t != blank -%}
                <option value="{{ t | handle }}"
                  {%- if current_tag == t or current_tag == t and current_tags -%} selected{%- endif -%}
                  {%- if current_tags contains t %} selected{%- endif -%}>
                  {{ t }}
                </option>
              {%- endif -%}
            {%- endfor -%}
          </select>
        {%- endif -%}
      {%- endfor -%}

      <!-- Spacer -->
      <div style="flex:1;"></div>

      <!-- Sort dropdown -->
      <div class="collection-filter-bar__sort">
        <span class="collection-filter-bar__label">Sort</span>
        <select class="filter-sort-select" id="collection-sort" aria-label="Sort products">
          <option value="relevance"          {% if sort_by == 'relevance' %}selected{% endif %}>Relevance</option>
          <option value="best-selling"       {% if sort_by == 'best-selling' %}selected{% endif %}>Best Selling</option>
          <option value="price-ascending"    {% if sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
          <option value="price-descending"   {% if sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
          <option value="created-descending" {% if sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
          <option value="title-ascending"    {% if sort_by == 'title-ascending' %}selected{% endif %}>A – Z</option>
        </select>
      </div>

    </div>
  </div>
</div>

<!-- Product grid -->
<section class="section collection-grid-section">
  <div class="container">

    {%- paginate collection.products by section.settings.products_per_page -%}

      {%- if collection.products.size == 0 -%}
        <p class="collection-empty">No products found.</p>
      {%- else -%}
        <div class="collection-grid">
          {%- for product in collection.products -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}">&larr;</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span {%- if part.title == paginate.current_page %} class="current"{%- endif -%}>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}">&rarr;</a>
          {%- endif -%}
        </nav>
      {%- endif -%}

    {%- endpaginate -%}

  </div>
</section>

<script>
  // Group filter dropdowns
  document.querySelectorAll('.filter-group-select').forEach(function (sel) {
    sel.addEventListener('change', function () {
      var base = this.dataset.collection;
      var tag  = this.value;
      var sort = new URLSearchParams(window.location.search).get('sort_by');
      var url  = tag ? (base + '/' + tag) : base;
      if (sort) url += '?sort_by=' + sort;
      window.location = url;
    });
  });

  // Sort dropdown
  document.getElementById('collection-sort').addEventListener('change', function () {
    var url = new URL(window.location.href);
    url.searchParams.set('sort_by', this.value);
    window.location = url.toString();
  });
</script>

{% schema %}
{
  "name": "Collection Page",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8, "max": 48, "step": 4,
      "default": 12
    },
    { "type": "header", "content": "Filter Group 1" },
    { "type": "text", "id": "group_1_label", "label": "Group label", "default": "Collection" },
    { "type": "text", "id": "group_1_tags",  "label": "Tags (comma-separated)", "default": "Reaver, Prime, Elderflame, Glitchpop" },
    { "type": "header", "content": "Filter Group 2" },
    { "type": "text", "id": "group_2_label", "label": "Group label", "default": "Rifle" },
    { "type": "text", "id": "group_2_tags",  "label": "Tags (comma-separated)", "default": "Vandal, Phantom, Spectre, Bulldog" },
    { "type": "header", "content": "Filter Group 3" },
    { "type": "text", "id": "group_3_label", "label": "Group label", "default": "Knife" },
    { "type": "text", "id": "group_3_tags",  "label": "Tags (comma-separated)", "default": "Karambit, Kunai, Butterfly" },
    { "type": "header", "content": "Filter Group 4" },
    { "type": "text", "id": "group_4_label", "label": "Group label", "default": "Type" },
    { "type": "text", "id": "group_4_tags",  "label": "Tags (comma-separated)", "default": "Keychain" }
  ]
}
{% endschema %}
