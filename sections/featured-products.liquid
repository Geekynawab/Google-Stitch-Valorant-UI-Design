<section class="section featured-products">
  <div class="container">

    <!-- Row 1: Bestsellers (grouped: knives → rifles → keychains, shuffled within each group) -->
    <div class="fp-row">
      <div class="fp-row__header">
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <div class="fp-scroll-row" id="fp-row-bestsellers">
        {%- assign group_blocks = section.blocks | where: 'type', 'product_group' -%}

        {%- if group_blocks.size > 0 -%}
          {%- for block in group_blocks -%}
            {%- assign grp_coll = collections[block.settings.collection] -%}
            {%- if grp_coll != blank -%}
              <div class="fp-group" data-group="{{ forloop.index }}" style="display:contents">
                {%- for product in grp_coll.products limit: block.settings.limit -%}
                  {%- render 'product-card', product: product -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..6) -%}
            <div class="product-card">
              <div class="product-card__image-wrap">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
              <div class="product-card__info">
                <h4 class="product-card__title">Sample Product {{ i }}</h4>
                <div class="product-card__price-row"><span class="product-card__price">$99.00</span></div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
      <div class="fp-scrollbar-track" data-for="fp-row-bestsellers">
        <div class="fp-scrollbar-thumb"></div>
      </div>
    </div>

    <!-- Row 2: Shop by Collection -->
    {%- assign coll_blocks = section.blocks | where: 'type', 'collection_link' -%}
    {%- if section.settings.heading_2 != blank -%}
    <div class="fp-row">
      <div class="fp-row__header">
        <h2>{{ section.settings.heading_2 }}</h2>
      </div>
      <div class="fp-scroll-row fp-coll-row" id="fp-row-collections">
        {%- if coll_blocks.size > 0 -%}
          {%- for block in coll_blocks -%}
            {%- assign coll = collections[block.settings.collection] -%}
            {%- assign tile_label = block.settings.label -%}
            {%- if tile_label == blank -%}{%- assign tile_label = coll.title -%}{%- endif -%}
            {%- assign tile_url = coll.url | default: '#' -%}
            {%- assign tile_img = block.settings.image -%}
            {%- if tile_img == blank -%}{%- assign tile_img = coll.image -%}{%- endif -%}
            {%- if tile_img == blank and coll.products.size > 0 -%}
              {%- assign tile_img = coll.products.first.featured_image -%}
            {%- endif -%}
            <a href="{{ tile_url }}" class="fp-coll-tile" data-electric-border {{ block.shopify_attributes }}>
              {%- if tile_img != blank -%}
                <img src="{{ tile_img | image_url: width: 400 }}"
                     alt="{{ tile_label | escape }}"
                     width="400" height="500"
                     loading="lazy">
              {%- else -%}
                <div class="fp-coll-tile__placeholder"></div>
              {%- endif -%}
              <div class="fp-coll-tile__overlay"></div>
              <div class="fp-coll-tile__label">{{ tile_label | upcase }}</div>
            </a>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="fp-coll-tile">
              <div class="fp-coll-tile__placeholder"></div>
              <div class="fp-coll-tile__overlay"></div>
              <div class="fp-coll-tile__label">COLLECTION {{ i }}</div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
      <div class="fp-scrollbar-track" data-for="fp-row-collections">
        <div class="fp-scrollbar-thumb"></div>
      </div>
    </div>
    {%- endif -%}

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    /* ── Shuffle bestsellers within groups ── */
    document.querySelectorAll('#fp-row-bestsellers .fp-group').forEach(function (group) {
      var cards = Array.from(group.children);
      for (var i = cards.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        group.insertBefore(cards[j], cards[i]);
      }
    });

    /* ── Shuffle collection tiles ── */
    var collRow = document.getElementById('fp-row-collections');
    if (collRow) {
      var tiles = Array.from(collRow.children);
      for (var i = tiles.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        collRow.insertBefore(tiles[j], tiles[i]);
      }
    }

    /* ── Custom scrollbars ── */
    document.querySelectorAll('.fp-scrollbar-track').forEach(function (track) {
      var row = document.getElementById(track.dataset.for);
      var thumb = track.querySelector('.fp-scrollbar-thumb');
      if (!row || !thumb) return;

      var currentLeft = 0, targetLeft = 0, currentWidth = 0, rafId = null;

      function getMetrics() {
        var scrollable = row.scrollWidth - row.clientWidth;
        if (scrollable <= 0) return null;
        var thumbPct = (row.clientWidth / row.scrollWidth) * 100;
        var leftPct  = (row.scrollLeft / scrollable) * (100 - thumbPct);
        return { thumbPct: thumbPct, leftPct: leftPct };
      }

      function loop() {
        var m = getMetrics();
        if (!m) { track.style.display = 'none'; return; }
        track.style.display = '';
        /* lerp towards target for fluid feel */
        currentLeft  += (m.leftPct  - currentLeft)  * 0.18;
        currentWidth += (m.thumbPct - currentWidth)  * 0.18;
        thumb.style.width = currentWidth + '%';
        thumb.style.left  = currentLeft  + '%';
        rafId = requestAnimationFrame(loop);
      }

      function startLoop() {
        if (!rafId) loop();
      }
      function stopLoop() {
        if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
      }

      /* init */
      var m0 = getMetrics();
      if (m0) { currentLeft = m0.leftPct; currentWidth = m0.thumbPct; }
      startLoop();
      window.addEventListener('resize', function () {
        stopLoop(); startLoop();
      });

      /* drag */
      var dragging = false, startX, startScrollLeft;
      thumb.addEventListener('mousedown', function (e) {
        dragging = true;
        startX = e.clientX;
        startScrollLeft = row.scrollLeft;
        e.preventDefault();
      });
      document.addEventListener('mousemove', function (e) {
        if (!dragging) return;
        var scrollable = row.scrollWidth - row.clientWidth;
        var dx = e.clientX - startX;
        row.scrollLeft = startScrollLeft + dx / (track.clientWidth - thumb.offsetWidth) * scrollable;
      });
      document.addEventListener('mouseup', function () { dragging = false; });

      /* click track to smooth-scroll */
      track.addEventListener('click', function (e) {
        if (e.target === thumb) return;
        var rect = track.getBoundingClientRect();
        var ratio = (e.clientX - rect.left) / rect.width;
        row.scrollTo({ left: ratio * (row.scrollWidth - row.clientWidth), behavior: 'smooth' });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Featured Products",
  "max_blocks": 25,
  "blocks": [
    {
      "type": "product_group",
      "name": "Bestsellers Group",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "range", "id": "limit", "label": "Number of products", "min": 1, "max": 8, "step": 1, "default": 4 }
      ]
    },
    {
      "type": "collection_link",
      "name": "Collection Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label override (optional)" },
        { "type": "image_picker", "id": "image", "label": "Image override (optional)" }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Row 1 — Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "BESTSELLERS" },
    { "type": "header", "content": "Row 2 — Shop by Collection" },
    { "type": "text", "id": "heading_2", "label": "Heading (leave blank to hide)", "default": "SHOP BY COLLECTION" }
  ],
  "presets": [{ "name": "Featured Products" }]
}
{% endschema %}
