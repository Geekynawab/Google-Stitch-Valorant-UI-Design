<div class="container">{% render 'breadcrumb' %}</div>

<section class="section page-section">
  <div class="container">
    <div class="page-layout">

      <div class="page-layout__header">
        <div class="page-layout__accent"></div>
        <h1 class="page-layout__title">{{ page.title }}</h1>
      </div>

      <div class="page-layout__body">
        {{ page.content }}
      </div>

    </div>
  </div>
</section>

{% schema %}
{ "name": "Page" }
{% endschema %}
