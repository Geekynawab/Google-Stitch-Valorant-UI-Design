{%- assign patch_num = nil -%}
{%- for tag in article.tags -%}
  {%- if tag contains 'patch:' -%}{%- assign patch_num = tag | remove: 'patch:' -%}{%- endif -%}
{%- endfor -%}

<div class="container">{% render 'breadcrumb' %}</div>

<article class="article-page">

  <!-- Blurred hero + centered image -->
  {%- if article.image -%}
    <div class="article-hero-wrap">
      <div class="article-hero-bg" style="background-image:url('{{ article.image | image_url: width: 1400 }}');"></div>
      <div class="article-hero-dim"></div>
      <div class="article-hero-img">
        <img src="{{ article.image | image_url: width: 860 }}"
             alt="{{ article.image.alt | escape | default: article.title }}"
             loading="eager">
      </div>
    </div>
  {%- endif -%}

  <!-- Title + meta -->
  <div class="container">
    <div class="article-layout">

      {%- if patch_num != blank -%}
        <p class="article-patch-label">// PATCH NOTES &nbsp; <strong>{{ patch_num }}</strong></p>
      {%- endif -%}

      <h1 class="article-title">{{ article.title }}</h1>

      <!-- Valorant-style divider -->
      <div class="article-divider">
        <span class="article-divider__bar"></span>
        <span class="article-divider__diamond"></span>
        <span class="article-divider__bar"></span>
      </div>

      <div class="article-meta-bar">
        <span class="article-meta__date">{{ article.published_at | date: '%b %d, %Y' | upcase }}</span>
        {%- if article.author != blank -%}
          <span class="article-meta__sep">//</span>
          <span class="article-meta__author">{{ article.author | upcase }}</span>
        {%- endif -%}
        {%- for tag in article.tags -%}
          {%- unless tag contains 'patch:' -%}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article-tag">{{ tag }}</a>
          {%- endunless -%}
        {%- endfor -%}
      </div>

      <div class="article-body rte">
        {{ article.content }}
      </div>

      <footer class="article-footer">
        <div class="article-footer__line"></div>
        <a href="{{ blog.url }}" class="article-back">
          <span class="material-symbols-outlined" style="font-size:15px;vertical-align:middle;">arrow_back</span>
          Back to {{ blog.title }}
        </a>
      </footer>

    </div>
  </div>

</article>

{% schema %}
{ "name": "Article Page" }
{% endschema %}
