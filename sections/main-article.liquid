{%- assign patch_num = nil -%}
{%- for tag in article.tags -%}
  {%- if tag contains 'patch:' -%}{%- assign patch_num = tag | remove: 'patch:' -%}{%- endif -%}
{%- endfor -%}

<div class="container">{% render 'breadcrumb' %}</div>

<article class="article-page">

  <!-- Blurred hero + centered image -->
  {%- if article.image -%}
    <div class="article-hero-wrap">
      <div class="article-hero-bg" style="background-image:url('{{ article.image | image_url: width: 1400 }}');"></div>
      <div class="article-hero-dim"></div>
      <div class="article-hero-img">
        <img src="{{ article.image | image_url: width: 860 }}"
             alt="{{ article.image.alt | escape | default: article.title }}"
             loading="eager">
      </div>
    </div>
  {%- endif -%}

  <!-- Title + meta -->
  <div class="container">
    <div class="article-layout">

      {%- if patch_num != blank -%}
        <p class="article-patch-label">// PATCH NOTES &nbsp; <strong>{{ patch_num }}</strong></p>
      {%- endif -%}

      <h1 class="article-title">{{ article.title }}</h1>

      <!-- Valorant-style divider -->
      <div class="article-divider">
        <span class="article-divider__bar"></span>
        <span class="article-divider__diamond"></span>
        <span class="article-divider__bar"></span>
      </div>

      <div class="article-meta-bar">
        <span class="article-meta__date">{{ article.published_at | date: '%b %d, %Y' | upcase }}</span>
        {%- if article.author != blank -%}
          <span class="article-meta__sep">//</span>
          <span class="article-meta__author">{{ article.author | upcase }}</span>
        {%- endif -%}
        {%- for tag in article.tags -%}
          {%- unless tag contains 'patch:' -%}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article-tag">{{ tag }}</a>
          {%- endunless -%}
        {%- endfor -%}
      </div>

      <div class="article-body rte">
        {{ article.content }}
      </div>

      <footer class="article-footer">
        <div class="article-footer__line"></div>
        <a href="{{ blog.url }}" class="article-back">
          <span class="material-symbols-outlined" style="font-size:15px;vertical-align:middle;">arrow_back</span>
          Back to {{ blog.title }}
        </a>
      </footer>

    </div>
  </div>

  <!-- Related articles: tag-matched, or pseudo-random fallback -->
  {%- assign related_count = 0 -%}

  {%- capture related_cards -%}
    {%- for other in blog.articles -%}
      {%- if related_count >= 3 -%}{%- break -%}{%- endif -%}
      {%- if other.id == article.id -%}{%- continue -%}{%- endif -%}
      {%- assign matched = false -%}
      {%- for tag in article.tags -%}
        {%- unless tag contains 'patch:' -%}
          {%- if other.tags contains tag -%}{%- assign matched = true -%}{%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
      {%- if matched -%}
        {%- assign related_count = related_count | plus: 1 -%}
        <a href="{{ other.url }}" class="blog-card blog-card--related">
          <div class="blog-card__img-wrap">
            {%- if other.image -%}
              <img src="{{ other.image | image_url: width: 480 }}" alt="{{ other.image.alt | escape | default: other.title }}" loading="lazy" width="480" height="320">
            {%- else -%}
              <div class="blog-card__img-placeholder"></div>
            {%- endif -%}
          </div>
          <div class="blog-card__body">
            <span class="blog-card__date">{{ other.published_at | date: '%b %d, %Y' }}</span>
            <h3 class="blog-card__title">{{ other.title }}</h3>
            {%- if other.excerpt != blank -%}
              <p class="blog-card__excerpt">{{ other.excerpt | strip_html | truncate: 90 }}</p>
            {%- endif -%}
            <span class="blog-card__read-more">Read more &rarr;</span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if related_count == 0 and blog.articles.size > 1 -%}
    {%- assign fallback_offset = article.id | modulo: blog.articles.size -%}
    {%- assign fallback_count = 0 -%}
    {%- capture related_cards -%}
      {%- for other in blog.articles offset: fallback_offset -%}
        {%- if fallback_count >= 3 -%}{%- break -%}{%- endif -%}
        {%- if other.id == article.id -%}{%- continue -%}{%- endif -%}
        {%- assign fallback_count = fallback_count | plus: 1 -%}
        <a href="{{ other.url }}" class="blog-card blog-card--related">
          <div class="blog-card__img-wrap">
            {%- if other.image -%}
              <img src="{{ other.image | image_url: width: 480 }}" alt="{{ other.image.alt | escape | default: other.title }}" loading="lazy" width="480" height="320">
            {%- else -%}
              <div class="blog-card__img-placeholder"></div>
            {%- endif -%}
          </div>
          <div class="blog-card__body">
            <span class="blog-card__date">{{ other.published_at | date: '%b %d, %Y' }}</span>
            <h3 class="blog-card__title">{{ other.title }}</h3>
            {%- if other.excerpt != blank -%}
              <p class="blog-card__excerpt">{{ other.excerpt | strip_html | truncate: 90 }}</p>
            {%- endif -%}
            <span class="blog-card__read-more">Read more &rarr;</span>
          </div>
        </a>
      {%- endfor -%}
      {%- if fallback_count < 3 -%}
        {%- for other in blog.articles -%}
          {%- if fallback_count >= 3 -%}{%- break -%}{%- endif -%}
          {%- if other.id == article.id -%}{%- continue -%}{%- endif -%}
          {%- assign fallback_count = fallback_count | plus: 1 -%}
          <a href="{{ other.url }}" class="blog-card blog-card--related">
            <div class="blog-card__img-wrap">
              {%- if other.image -%}
                <img src="{{ other.image | image_url: width: 480 }}" alt="{{ other.image.alt | escape | default: other.title }}" loading="lazy" width="480" height="320">
              {%- else -%}
                <div class="blog-card__img-placeholder"></div>
              {%- endif -%}
            </div>
            <div class="blog-card__body">
              <span class="blog-card__date">{{ other.published_at | date: '%b %d, %Y' }}</span>
              <h3 class="blog-card__title">{{ other.title }}</h3>
              {%- if other.excerpt != blank -%}
                <p class="blog-card__excerpt">{{ other.excerpt | strip_html | truncate: 90 }}</p>
              {%- endif -%}
              <span class="blog-card__read-more">Read more &rarr;</span>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}
  {%- endif -%}

  {%- unless related_cards == blank -%}
    <div class="related-articles">
      <div class="container">
        <div class="related-articles__header">
          <span class="related-articles__label">// RELATED</span>
          <div class="related-articles__bar"></div>
        </div>
        <div class="related-articles__grid">
          {{ related_cards }}
        </div>
      </div>
    </div>
  {%- endunless -%}

</article>

{% schema %}
{ "name": "Article Page" }
{% endschema %}
