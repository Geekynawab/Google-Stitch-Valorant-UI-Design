<section class="model-showcase" id="model-showcase-{{ section.id }}">
  <div class="container">
    <div class="model-showcase__layout">

      <div class="model-showcase__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="model-showcase__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="model-showcase__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="model-showcase__desc">{{ section.settings.description }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn-primary">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>

      <div class="model-showcase__viewer-wrap">
        <model-viewer
          src="{{ section.settings.model_file | default: 'katana_valorant_draft.glb' | asset_url }}"
          camera-controls
          shadow-intensity="1"
          shadow-softness="0.5"
          exposure="0.9"
          environment-image="neutral"
          {%- if section.settings.auto_rotate %}auto-rotate auto-rotate-delay="0"{%- endif %}
          style="width:100%;height:100%;background:transparent;"
        >
          <div slot="progress-bar" class="model-showcase__progress">
            <div class="model-showcase__progress-bar"></div>
          </div>
        </model-viewer>
        <div class="model-showcase__drag-hint">
          <span class="material-symbols-outlined">drag_pan</span>
          Drag to rotate
        </div>
      </div>

    </div>
  </div>
</section>

<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"></script>

<style>
.model-showcase {
  padding: var(--space-24) 0;
  background: var(--color-surface);
  overflow: hidden;
}
.model-showcase__layout {
  display: flex;
  align-items: center;
  gap: var(--space-16);
}
.model-showcase__text {
  flex: 0 0 auto;
  max-width: 380px;
}
.model-showcase__eyebrow {
  font-size: 0.7rem; font-weight: 700; letter-spacing: 0.22em;
  text-transform: uppercase; color: var(--color-accent);
  margin-bottom: var(--space-4);
}
.model-showcase__title {
  font-family: var(--font-valorant);
  font-size: clamp(1.8rem, 3vw, 3rem);
  line-height: 1.1; text-transform: uppercase;
  color: var(--color-text-primary); margin-bottom: var(--space-4);
}
.model-showcase__desc {
  font-size: 1rem; line-height: 1.6;
  color: var(--color-on-surface-variant); margin-bottom: var(--space-8);
}
.model-showcase__viewer-wrap {
  flex: 1;
  min-width: 0;
  position: relative;
  height: 520px;
  border-radius: 16px;
  border: 1px solid rgba(255, 70, 85, 0.3);
  overflow: hidden;
  background: transparent;
}
.model-showcase__drag-hint {
  position: absolute;
  bottom: 16px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: 999px;
  background: rgba(0,0,0,0.55);
  border: 1px solid rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.7);
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-family: var(--font-headline);
  pointer-events: none;
  white-space: nowrap;
}
.model-showcase__drag-hint .material-symbols-outlined { font-size: 1rem; opacity: 0.8; }
.model-showcase__progress {
  width: 100%; height: 3px;
  background: var(--color-surface-container);
  position: absolute; top: 0; left: 0;
}
.model-showcase__progress-bar {
  height: 100%;
  background: var(--color-accent);
  width: var(--progress-bar-width, 0%);
  transition: width 0.2s;
}
@media (max-width: 900px) {
  .model-showcase__layout { flex-direction: column-reverse; }
  .model-showcase__viewer-wrap { width: 100%; height: 380px; }
  .model-showcase__text { max-width: 100%; }
}
</style>

{% schema %}
{
  "name": "Model Showcase",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured Weapon"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Valorant Katana"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A blade built for those who move in silence. Wide. Swift. Unmistakable."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "model_file",
      "label": "3D Model",
      "options": [
        { "value": "katana_valorant_draft.glb",              "label": "Katana Draft" },
        { "value": "valorant_champions_butterfly_knife.glb", "label": "Champions Butterfly Knife" },
        { "value": "karambit_prime_2.0_valorant.glb",        "label": "Prime 2.0 Karambit" },
        { "value": "reaver_karambit.glb",                    "label": "Reaver Karambit" },
        { "value": "valorant_glitchpop_dagger.glb",          "label": "Glitchpop Dagger" }
      ],
      "default": "katana_valorant_draft.glb"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Model Showcase",
      "settings": {
        "eyebrow": "Featured Weapon",
        "title": "Valorant Katana",
        "description": "A blade built for those who move in silence. Wide. Swift. Unmistakable.",
        "cta_label": "Shop Now",
        "model_file": "katana_valorant_draft.glb",
        "auto_rotate": false
      }
    }
  ]
}
{% endschema %}
