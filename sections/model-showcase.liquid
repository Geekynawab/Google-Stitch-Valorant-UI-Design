<section class="model-showcase" id="model-showcase-{{ section.id }}">
  <div class="container">
    <div class="model-showcase__layout">

      <div class="model-showcase__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="model-showcase__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="model-showcase__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="model-showcase__desc">{{ section.settings.description }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn-primary">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>

      <div class="model-showcase__embed-wrap">
        <iframe
          title="{{ section.settings.title | escape }}"
          src="{{ section.settings.embed_url }}"
          frameborder="0"
          allowfullscreen
          mozallowfullscreen="true"
          webkitallowfullscreen="true"
          allow="autoplay; fullscreen; xr-spatial-tracking"
          class="model-showcase__iframe"
          loading="lazy"
        ></iframe>
      </div>

    </div>
  </div>
</section>

<style>
.model-showcase {
  padding: var(--space-24) 0;
  background: var(--color-surface);
  overflow: hidden;
}
.model-showcase__layout {
  display: flex;
  align-items: center;
  gap: var(--space-16);
}
.model-showcase__text {
  flex: 0 0 auto;
  max-width: 380px;
}
.model-showcase__eyebrow {
  font-size: 0.7rem; font-weight: 700; letter-spacing: 0.22em;
  text-transform: uppercase; color: var(--color-accent);
  margin-bottom: var(--space-4);
}
.model-showcase__title {
  font-family: var(--font-valorant);
  font-size: clamp(1.8rem, 3vw, 3rem);
  line-height: 1.1; text-transform: uppercase;
  color: var(--color-text-primary); margin-bottom: var(--space-4);
}
.model-showcase__desc {
  font-size: 1rem; line-height: 1.6;
  color: var(--color-on-surface-variant); margin-bottom: var(--space-8);
}
.model-showcase__embed-wrap {
  flex: 1;
  min-width: 0;
  border-radius: 16px;
  border: 1px solid rgba(255, 70, 85, 0.3);
  overflow: hidden;
  aspect-ratio: 4 / 3;
}
.model-showcase__iframe {
  display: block;
  width: 100%;
  height: 100%;
}
@media (max-width: 900px) {
  .model-showcase__layout { flex-direction: column-reverse; }
  .model-showcase__embed-wrap { width: 100%; }
  .model-showcase__text { max-width: 100%; }
}
</style>

{% schema %}
{
  "name": "Model Showcase",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured Weapon"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Valorant Katana"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A blade built for those who move in silence. Wide. Swift. Unmistakable."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "embed_url",
      "label": "Sketchfab embed URL",
      "default": "https://sketchfab.com/models/73ae18bf62f249f9ba6a3824201ce8b0/embed?ui_theme=dark&autostart=1&ui_infos=0"
    }
  ],
  "presets": [
    {
      "name": "Model Showcase",
      "settings": {
        "eyebrow": "Featured Weapon",
        "title": "Valorant Katana",
        "description": "A blade built for those who move in silence. Wide. Swift. Unmistakable.",
        "cta_label": "Shop Now",
        "embed_url": "https://sketchfab.com/models/73ae18bf62f249f9ba6a3824201ce8b0/embed?ui_theme=dark&autostart=1&ui_infos=0"
      }
    }
  ]
}
{% endschema %}
