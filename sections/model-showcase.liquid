<section class="model-showcase" id="model-showcase-{{ section.id }}">
  <div class="container">
    <div class="model-showcase__layout">

      <div class="model-showcase__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="model-showcase__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="model-showcase__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="model-showcase__desc">{{ section.settings.description }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn-primary">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>

      <div class="model-showcase__canvas-wrap">
        <div
          id="model-viewer-mount-{{ section.id }}"
          class="model-showcase__canvas"
          data-src="{{ section.settings.model_file | default: 'katana_valorant_draft.glb' | asset_url }}"
        ></div>
        <div class="model-showcase__drag-hint">
          <span class="material-symbols-outlined">drag_pan</span>
          Drag to rotate
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.model-showcase {
  padding: var(--space-24) 0;
  background: var(--color-surface);
  overflow: hidden;
}
.model-showcase__layout {
  display: flex;
  align-items: center;
  gap: var(--space-16);
}
.model-showcase__text {
  flex: 0 0 auto;
  max-width: 420px;
}
.model-showcase__eyebrow {
  font-size: 0.7rem; font-weight: 700; letter-spacing: 0.22em;
  text-transform: uppercase; color: var(--color-accent);
  margin-bottom: var(--space-4);
}
.model-showcase__title {
  font-family: var(--font-valorant);
  font-size: clamp(1.8rem, 3vw, 3rem);
  line-height: 1.1; text-transform: uppercase;
  color: var(--color-text-primary); margin-bottom: var(--space-4);
}
.model-showcase__desc {
  font-size: 1rem; line-height: 1.6;
  color: var(--color-on-surface-variant); margin-bottom: var(--space-8);
}
.model-showcase__canvas-wrap {
  flex: 1;
  min-width: 0;
  position: relative;
  border-radius: 16px;
  border: 1px solid rgba(255, 70, 85, 0.3);
  overflow: hidden;
}
.model-showcase__canvas {
  width: 100%;
  height: 520px;
  background: transparent;
}
.model-showcase__canvas canvas { display: block; }
.model-showcase__drag-hint {
  position: absolute;
  bottom: 16px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: 999px;
  background: rgba(0,0,0,0.55);
  border: 1px solid rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.7);
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-family: var(--font-headline);
  pointer-events: none;
  white-space: nowrap;
}
.model-showcase__drag-hint .material-symbols-outlined {
  font-size: 1rem;
  opacity: 0.8;
}
.model-showcase__loading {
  display: flex; align-items: center; justify-content: center;
  height: 100%; color: var(--color-text-secondary);
  font-family: var(--font-headline); font-size: 0.75rem;
  letter-spacing: 0.15em; text-transform: uppercase;
}
@media (max-width: 900px) {
  .model-showcase__layout { flex-direction: column-reverse; }
  .model-showcase__canvas { height: 380px; }
  .model-showcase__text { max-width: 100%; }
}
</style>

<script>var _mvSectionId = {{ section.id | json }};</script>
{% raw %}
<script type="module">
import htm from 'https://esm.sh/htm@3';
import React, { Suspense, useRef, useLayoutEffect, useMemo } from 'https://esm.sh/react@18';
import { createRoot } from 'https://esm.sh/react-dom@18/client';
import { Canvas, useThree, invalidate } from 'https://esm.sh/@react-three/fiber@8?deps=react@18,three@0.158.0';
import { OrbitControls, useGLTF, useProgress, Html, Environment, ContactShadows } from 'https://esm.sh/@react-three/drei@9?deps=react@18,three@0.158.0,@react-three/fiber@8';
import * as THREE from 'https://esm.sh/three@0.158.0';

const html = htm.bind(React.createElement);

function Loader() {
  const { progress } = useProgress();
  return html`<${Html} center><div class="model-showcase__loading">Loading ${Math.round(progress)}%</div></${Html}>`;
}

function ModelScene({ url, fadeIn }) {
  const groupRef = useRef(null);
  const { camera } = useThree();
  const { scene } = useGLTF(url);
  const content = useMemo(() => scene.clone(), [scene]);

  useLayoutEffect(() => {
    if (!content || !groupRef.current) return;
    const g = groupRef.current;
    g.updateWorldMatrix(true, true);

    const sphere = new THREE.Box3().setFromObject(g).getBoundingSphere(new THREE.Sphere());
    const s = 1 / (sphere.radius * 2);
    g.position.set(-sphere.center.x, -sphere.center.y, -sphere.center.z);
    g.scale.setScalar(s);

    if (camera.isPerspectiveCamera) {
      const d = 1.1 / Math.sin((camera.fov * Math.PI) / 180 / 2);
      camera.position.set(0, 0, d);
      camera.near = d / 20;
      camera.far = d * 20;
      camera.updateProjectionMatrix();
    }

    g.traverse(o => {
      if (o.isMesh) {
        o.castShadow = true;
        o.receiveShadow = true;
        if (fadeIn) { o.material = o.material.clone(); o.material.transparent = true; o.material.opacity = 0; }
      }
    });

    if (fadeIn) {
      let t = 0;
      const id = setInterval(() => {
        t += 0.05;
        const v = Math.min(t, 1);
        g.traverse(o => { if (o.isMesh) o.material.opacity = v; });
        invalidate();
        if (v >= 1) clearInterval(id);
      }, 16);
      return () => clearInterval(id);
    }
  }, [content]);

  if (!content) return null;
  return html`<group ref=${groupRef}><primitive object=${content} /></group>`;
}

function ModelViewer({ url, autoRotate, fadeIn }) {
  return html`
    <div style=${{ width: '100%', height: '100%', touchAction: 'none' }}>
      <${Canvas}
        shadows=${true}
        frameloop="always"
        gl=${{ antialias: true, alpha: true }}
        onCreated=${({ gl }) => {
          gl.toneMapping = THREE.ACESFilmicToneMapping;
          gl.outputColorSpace = THREE.SRGBColorSpace;
          gl.setClearColor(0x000000, 0);
        }}
        camera=${{ fov: 50, position: [0, 0, 3], near: 0.01, far: 100 }}
        style=${{ background: 'transparent' }}
      >
        <ambientLight intensity=${0.4} />
        <directionalLight position=${[5, 5, 5]} intensity=${1.2} castShadow=${true} />
        <directionalLight position=${[-5, 2, 5]} intensity=${0.5} />
        <directionalLight position=${[0, 4, -5]} intensity=${0.8} />
        <${Environment} preset="forest" background=${false} />
        <${ContactShadows} position=${[0, -0.5, 0]} opacity=${0.4} scale=${10} blur=${2} />
        <${Suspense} fallback=${html`<${Loader} />`}>
          <${ModelScene} url=${url} fadeIn=${fadeIn} />
        </${Suspense}>
        <${OrbitControls}
          makeDefault
          enablePan=${false}
          enableZoom=${true}
          enableRotate=${true}
          autoRotate=${autoRotate}
          autoRotateSpeed=${1.5}
          minDistance=${0.5}
          maxDistance=${8}
          enableDamping=${true}
          dampingFactor=${0.07}
          target=${[0, 0, 0]}
        />
      </${Canvas}>
    </div>
  `;
}

const container = document.getElementById('model-viewer-mount-' + window._mvSectionId);
if (container) {
  const src = container.dataset.src;
  createRoot(container).render(html`<${ModelViewer} url=${src} autoRotate=${false} fadeIn=${true} />`);
}
</script>
{% endraw %}

{% schema %}
{
  "name": "Model Showcase",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured Weapon"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Champions Butterfly Knife"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "The rarest knife in Valorant history. Crafted to mark the 2021 World Championship, this blade is more than a weapon — it's a trophy."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "model_file",
      "label": "3D Model",
      "options": [
        { "value": "valorant_champions_butterfly_knife.glb", "label": "Champions Butterfly Knife" },
        { "value": "karambit_prime_2.0_valorant.glb",        "label": "Prime 2.0 Karambit" },
        { "value": "reaver_karambit.glb",                    "label": "Reaver Karambit" },
        { "value": "valorant_glitchpop_dagger.glb",          "label": "Glitchpop Dagger" },
        { "value": "katana_valorant_draft.glb",              "label": "Katana Draft" }
      ],
      "default": "katana_valorant_draft.glb"
    }
  ],
  "presets": [
    {
      "name": "Model Showcase",
      "settings": {
        "eyebrow": "Featured Weapon",
        "title": "Valorant Katana",
        "description": "A blade built for those who move in silence. Wide. Swift. Unmistakable.",
        "cta_label": "Shop Now",
        "model_file": "katana_valorant_draft.glb"
      }
    }
  ]
}
{% endschema %}
