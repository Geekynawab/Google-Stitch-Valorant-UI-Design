{%- comment -%}
  Renders price with optional compare-at.
  Usage: {% render 'price', product: product %}
         {% render 'price', variant: variant %}
{%- endcomment -%}

{%- assign target = variant | default: product -%}
{%- assign compare_at = target.compare_at_price -%}
{%- assign price = target.price -%}
{%- unless compare_at > price -%}
  {%- assign compare_at = price | times: 10 | divided_by: 7 -%}
{%- endunless -%}

<span style="display:inline-flex;align-items:center;gap:0.25rem;flex-wrap:wrap;">
  <span class="product-card__price">{{ price | money }}</span>
  <span class="product-card__compare-price" style="color:rgba(217,227,242,0.75);text-decoration:line-through;font-size:1rem;">{{ compare_at | money }}</span>
  <span class="launch-offer-badge" style="margin-left:0.6rem;">Launch Offer</span>
</span>
